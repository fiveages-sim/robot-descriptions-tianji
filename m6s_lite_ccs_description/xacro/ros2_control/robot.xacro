<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="M6S_Lite_CCS">
	<xacro:arg name="ros2_control_hardware_type" default="mock_components"/>
	<xacro:arg name="gazebo" default="false"/>

	<xacro:include filename="$(find m6s_lite_ccs_description)/xacro/robot.xacro"/>
	<xacro:include filename="$(find robot_common_launch)/xacro/ros2_control/simulation_hardware.xacro"/>
	<xacro:include filename="$(find m6_ccs_description)/xacro/ros2_control/interfaces.xacro"/>

	<link name="world"/>
	<joint name="world_fixed" type="fixed">
		<parent link="world"/>
		<child link="base_link"/>
	</joint>

	<ros2_control name="M6S_Lite_CCS_System" type="system">
		<hardware>
			<xacro:simulation_hardware_plugin hardware_type="$(arg ros2_control_hardware_type)"/>
		</hardware>
		<xacro:if value="${selected_arm_config == 'dual'}">
			<xacro:m6_interfaces name="left"/>
			<xacro:m6_interfaces name="right"/>
		</xacro:if>
		<xacro:if value="${selected_arm_config == 'left'}">
			<xacro:m6_interfaces name=""/>
		</xacro:if>
		<xacro:if value="${selected_arm_config == 'right'}">
			<xacro:m6_interfaces name=""/>
		</xacro:if>
	</ros2_control>

	<xacro:if value="$(arg gazebo)">
		<gazebo>
			<plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
				<parameters>$(find m6s_lite_ccs_description)/config/ros2_control/common.yaml</parameters>
			</plugin>
		</gazebo>
	</xacro:if>
</robot>
