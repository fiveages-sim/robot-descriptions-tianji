<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
	<xacro:arg name="collider" default="convex"/>
	<xacro:arg name="eef_fixed_joints" default="false"/>
	<xacro:property name="PI" value="3.1415926535897931"/>
	<xacro:property name="collider_type" value="$(arg collider)"/>

	<!-- Canonical DH from Gento Luna right arm. DualArmMount orients left/right bases.
	     CAD has no separate flange: joint1 origin is coincident with base_link. -->
	<xacro:macro name="M6S_LITE_CCS" params="name:='' direction:=1 tcp_offset_xyz:='0 0 0' tcp_offset_rpy:='0 0 0'">
		<xacro:property name="prefix" value="${name + '_' if name else ''}"/>
		<!-- link1–7: shared meshes. Right arm: link2/5 scale Y, link7 scale Z; link6 visual ±90° about X. -->
		<xacro:property name="joint4_upper" value="${0 if '$(arg eef_fixed_joints)' == 'true' else 0.7854}"/>

		<link name="${prefix}base_link">
			<inertial>
				<origin xyz="0 0 0.02"/>
				<mass value="0.2"/>
				<inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
			</inertial>
		</link>

		<link name="${prefix}link1">
			<inertial>
				<origin xyz="-0.00033175 -0.00426687 -0.03522466"/>
				<mass value="1.537551"/>
				<inertia
						ixx="0.00366914" ixy="1.77e-06" ixz="1.342e-05"
						iyy="0.00394529" iyz="-0.00023437" izz="0.00131774"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find m6s_lite_ccs_description)/meshes/link1.glb"/>
				</geometry>
			</visual>
			<xacro:if value="${collider_type == 'convex'}">
				<collision>
					<geometry>
						<mesh filename="file://$(find m6s_lite_ccs_description)/meshes/link1.glb"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collider_type == 'simple'}">
				<collision>
					<origin xyz="0 0 -0.03"/>
					<geometry>
						<cylinder length="0.08" radius="0.045"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>

		<joint name="${prefix}joint1" type="revolute">
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<parent link="${prefix}base_link"/>
			<child link="${prefix}link1"/>
			<axis xyz="0 0 1"/>
			<limit lower="-3.0194" upper="3.0194" effort="35" velocity="${PI}"/>
		</joint>

		<link name="${prefix}link2">
			<inertial>
				<origin xyz="-0.00016285 0.04983697 -0.00833367"/>
				<mass value="1.540624"/>
				<inertia
						ixx="0.00598937" ixy="1.663e-05" ixz="8.58e-06"
						iyy="0.00183242" iyz="0.00064328" izz="0.00564358"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find m6s_lite_ccs_description)/meshes/link2.glb" />
				</geometry>
			</visual>
			<xacro:if value="${collider_type == 'convex'}">
				<collision>
					<geometry>
						<mesh filename="file://$(find m6s_lite_ccs_description)/meshes/link2.glb"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collider_type == 'simple'}">
				<collision>
					<origin xyz="0 0.12 0" rpy="${PI/2} 0 0"/>
					<geometry>
						<cylinder length="0.26" radius="0.04"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>

		<joint name="${prefix}joint2" type="revolute">
			<origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
			<parent link="${prefix}link1"/>
			<child link="${prefix}link2"/>
			<axis xyz="0 0 1"/>
			<limit lower="-2.0595" upper="2.0595" effort="35" velocity="${PI}"/>
		</joint>

		<link name="${prefix}link3">
			<inertial>
				<origin xyz="0.0082949 -0.00411162 -0.04916618"/>
				<mass value="1.361743"/>
				<inertia
						ixx="0.00467364" ixy="-5.704e-05" ixz="0.00058882"
						iyy="0.00498053" iyz="-0.00027207" izz="0.00119672"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find m6s_lite_ccs_description)/meshes/link3.glb"/>
				</geometry>
			</visual>
			<xacro:if value="${collider_type == 'convex'}">
				<collision>
					<geometry>
						<mesh filename="file://$(find m6s_lite_ccs_description)/meshes/link3.glb"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collider_type == 'simple'}">
				<collision>
					<origin xyz="0 0 -0.05"/>
					<geometry>
						<cylinder length="0.12" radius="0.04"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>

		<joint name="${prefix}joint3" type="revolute">
			<origin xyz="0 0.264 0" rpy="-${PI/2} 0 0"/>
			<parent link="${prefix}link2"/>
			<child link="${prefix}link3"/>
			<axis xyz="0 0 1"/>
			<limit lower="-3.0194" upper="3.0194" effort="18" velocity="${PI}"/>
		</joint>

		<link name="${prefix}link4">
			<inertial>
				<origin xyz="0.00852387 -0.03857074 -0.00801541"/>
				<mass value="1.034295"/>
				<inertia
						ixx="0.00303957" ixy="-0.00037917" ixz="6.787e-05"
						iyy="0.00118553" iyz="-0.00031048" izz="0.00288173"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find m6s_lite_ccs_description)/meshes/link4.glb"/>
				</geometry>
			</visual>
			<xacro:if value="${collider_type == 'convex'}">
				<collision>
					<geometry>
						<mesh filename="file://$(find m6s_lite_ccs_description)/meshes/link4.glb"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collider_type == 'simple'}">
				<collision>
					<origin xyz="0.018 -0.12 0" rpy="${PI/2} 0 0"/>
					<geometry>
						<cylinder length="0.26" radius="0.035"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>

		<joint name="${prefix}joint4" type="revolute">
			<origin xyz="0.018 0 0" rpy="-${PI/2} 0 ${PI}"/>
			<parent link="${prefix}link3"/>
			<child link="${prefix}link4"/>
			<axis xyz="0 0 1"/>
			<limit lower="-2.5307" upper="${joint4_upper}" effort="18" velocity="${PI}"/>
		</joint>

		<link name="${prefix}link5">
			<inertial>
				<origin xyz="${direction * 0.0005008} ${direction * -0.00223923} -0.09253416"/>
				<mass value="1.000479"/>
				<inertia
						ixx="0.00217057" ixy="-1.142e-05" ixz="${direction * 6.68e-06}"
						iyy="0.00195131" iyz="${direction * -3.059e-05}" izz="0.00084222"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find m6s_lite_ccs_description)/meshes/link5.glb" scale="1 ${direction} 1"/>
				</geometry>
			</visual>
			<xacro:if value="${collider_type == 'convex'}">
				<collision>
					<geometry>
						<mesh filename="file://$(find m6s_lite_ccs_description)/meshes/link5.glb" scale="1 ${direction} 1"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collider_type == 'simple'}">
				<collision>
					<origin xyz="0 0 -0.09"/>
					<geometry>
						<cylinder length="0.18" radius="0.04"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>

		<joint name="${prefix}joint5" type="revolute">
			<origin xyz="0.018 -0.264 0" rpy="-${PI/2} 0 ${PI}"/>
			<parent link="${prefix}link4"/>
			<child link="${prefix}link5"/>
			<axis xyz="0 0 1"/>
			<limit lower="-3.0194" upper="3.0194" effort="5.5" velocity="${PI}"/>
		</joint>

		<link name="${prefix}link6">
			<inertial>
				<origin xyz="${direction * -0.00018634} 0.00023824 ${direction * 0.0005829}"/>
				<mass value="0.3906229"/>
				<inertia
						ixx="0.00019943" ixy="${direction * -1.18e-06}" ixz="-3.0e-07"
						iyy="0.00017163" iyz="${direction * 3.53e-06}" izz="0.00018567"/>
			</inertial>
			<visual>
				<origin rpy="${direction * PI/2} 0 0" />
				<geometry>
					<mesh filename="file://$(find m6s_lite_ccs_description)/meshes/link6.glb"/>
				</geometry>
			</visual>
			<xacro:if value="${collider_type == 'convex'}">
				<collision>
					<origin rpy="${direction * PI/2} 0 0"/>
					<geometry>
						<mesh filename="file://$(find m6s_lite_ccs_description)/meshes/link6.glb"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collider_type == 'simple'}">
				<collision>
					<origin rpy="${PI/2} 0 0"/>
					<geometry>
						<cylinder length="0.08" radius="0.03"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>

		<joint name="${prefix}joint6" type="revolute">
			<origin rpy="${PI/2} -${PI/2} 0"/>
			<parent link="${prefix}link5"/>
			<child link="${prefix}link6"/>
			<axis xyz="0 0 1"/>
			<limit lower="-1.0472" upper="1.0472" effort="5.5" velocity="${PI}"/>
		</joint>

		<link name="${prefix}link7">
			<inertial>
				<origin xyz="-0.00052431 -0.03976234 0.00727342"/>
				<mass value="0.37939"/>
				<inertia
						ixx="0.00070308" ixy="5.97e-06" ixz="7.3e-07"
						iyy="0.00030365" iyz="0.00012769" izz="0.00058833"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find m6s_lite_ccs_description)/meshes/link7.glb" scale="1 1 ${direction}"/>
				</geometry>
			</visual>
			<xacro:if value="${collider_type == 'convex'}">
				<collision>
					<geometry>
						<mesh filename="file://$(find m6s_lite_ccs_description)/meshes/link7.glb" scale="1 1 ${direction}"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collider_type == 'simple'}">
				<collision>
					<origin xyz="0 -0.04 0" rpy="${PI/2} 0 0"/>
					<geometry>
						<cylinder length="0.08" radius="0.03"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>

		<joint name="${prefix}joint7" type="revolute">
			<origin rpy="${PI/2} -${PI/2} 0"/>
			<parent link="${prefix}link6"/>
			<child link="${prefix}link7"/>
			<axis xyz="0 0 1"/>
			<limit lower="-${PI/2}" upper="${PI/2}" effort="5.5" velocity="${PI}"/>
		</joint>

		<link name="${prefix}tcp"/>
		<joint name="${prefix}tcp_joint" type="fixed">
			<origin rpy="${PI/2} -${PI/2} 0" xyz="0 -0.08 0"/>
			<parent link="${prefix}link7"/>
			<child link="${prefix}tcp"/>
		</joint>

		<link name="${prefix}tcp_offset"/>
		<joint name="${prefix}tcp_offset_joint" type="fixed">
			<origin xyz="${tcp_offset_xyz}" rpy="${tcp_offset_rpy}"/>
			<parent link="${prefix}tcp"/>
			<child link="${prefix}tcp_offset"/>
		</joint>
	</xacro:macro>
</robot>
