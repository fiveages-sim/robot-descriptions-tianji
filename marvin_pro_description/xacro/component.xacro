<?xml version="1.0"?>
<!--
  Component-wise description for Marvin Pro, used by
  robot_descriptions/common/robot_common_launch/launch/visualize/component.launch.py

  Supported types (arg "type"):
    - body (default): tall fixed base only (no arms / EEF)

  Isaac asset import: hide sensor_models camera meshes with isaac:=true
  (launch: xacro_isaac:=true). Independent of hardware:=isaac.
-->
<robot name="Marvin_Pro" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="type" default="body"/>
  <xacro:arg name="collider" default="simple"/>
  <xacro:arg name="isaac" default="true"/>

  <xacro:if value="${'$(arg type)' == 'body'}">
    <xacro:include filename="$(find marvin_pro_description)/xacro/components/base.xacro"/>
    <xacro:marvin_pro_base isaac="$(arg isaac)"/>
  </xacro:if>
</robot>
