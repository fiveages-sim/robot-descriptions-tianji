    {
      muPosition      10.0
      muOrientation    5.0
    }
}

finalEndEffector
{
  dualArmMode      true
  leftArm
    {
      muPosition      10.0
      muOrientation    5.0
    }

    ; 右臂特定配置
  rightArm
    {
      muPosition      10.0
      muOrientation    5.0
    }
