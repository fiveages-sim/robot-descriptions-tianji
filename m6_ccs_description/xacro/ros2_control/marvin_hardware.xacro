<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:include filename="$(find m6_ccs_description)/xacro/eefs.xacro"/>

	<!-- KWR75 per arm: none | kwr75_485 | kwr75_usb（defaults.ft / launch ft:= left_ft:=） -->
	<xacro:arg name="left_ft" default="none"/>
	<xacro:arg name="right_ft" default="none"/>
	<xacro:arg name="left_ft_channel" default="3"/>
	<xacro:arg name="right_ft_channel" default="3"/>
	<xacro:arg name="usb_left_ft_port" default="/dev/ttyUSB1"/>
	<xacro:arg name="usb_right_ft_port" default="/dev/ttyUSB3"/>

	<!-- arm_type: dual | left | right -->
	<xacro:macro name="marvin_hardware_block" params="
		arm_type
		arm_ctrl_mode
		max_joint_speed
		max_joint_acceleration
		device_ip
		left_dyn_param
		right_dyn_param
		selected_gripper_type:=none">
		<plugin>marvin_ros2_control/MarvinHardware</plugin>
		<param name="arm_type">${arm_type}</param>
		<xacro:if value="${'$(arg left_ft)' == 'kwr75_485' or '$(arg right_ft)' == 'kwr75_485'}">
			<param name="kwr75_ft_enabled">true</param>
			<xacro:if value="${'$(arg left_ft)' == 'kwr75_485'}">
				<param name="left_ft_enabled">true</param>
			</xacro:if>
			<xacro:if value="${'$(arg right_ft)' == 'kwr75_485'}">
				<param name="right_ft_enabled">true</param>
			</xacro:if>
			<param name="left_ft_channel">$(arg left_ft_channel)</param>
			<param name="right_ft_channel">$(arg right_ft_channel)</param>
			<param name="ft_command_code">72</param>
			<param name="ft_poll_interval_ms">0</param>
			<param name="left_ft_frame_id">left_eef</param>
			<param name="right_ft_frame_id">right_eef</param>
			<param name="use_async_tool_comm">true</param>
		</xacro:if>
		<xacro:if value="${arm_type == 'dual'}">
			<xacro:property name="left_ee_type" value="${left_hand_type if left_hand_type != '' else left_gripper_type}"/>
			<xacro:property name="right_ee_type" value="${right_hand_type if right_hand_type != '' else right_gripper_type}"/>
			<xacro:if value="${(left_drive_type == 'marvin' or left_drive_type == 'tianji_can') and left_ee_type != '' and left_ee_type != 'xhand1' and left_ee_type != 'inspire_e2'}">
				<param name="left_ee_type">${left_ee_type}</param>
				<xacro:if value="${left_drive_type == 'tianji_can'}">
					<param name="left_ee_channel">1</param>
				</xacro:if>
			</xacro:if>
			<xacro:if value="${(right_drive_type == 'marvin' or right_drive_type == 'tianji_can') and right_ee_type != '' and right_ee_type != 'xhand1' and right_ee_type != 'inspire_e2'}">
				<param name="right_ee_type">${right_ee_type}</param>
				<xacro:if value="${right_drive_type == 'tianji_can'}">
					<param name="right_ee_channel">1</param>
				</xacro:if>
			</xacro:if>
			<xacro:ee_dyn_param side="left"
				ee_key="${left_hand_type if left_hand_type != '' else left_gripper_type}"
				arg_val="${left_dyn_param}"/>
			<xacro:ee_dyn_param side="right"
				ee_key="${right_hand_type if right_hand_type != '' else right_gripper_type}"
				arg_val="${right_dyn_param}"/>
		</xacro:if>
		<xacro:unless value="${arm_type == 'dual'}">
			<xacro:if value="${selected_gripper_type != 'none'}">
				<param name="left_ee_type">${selected_gripper_type}</param>
			</xacro:if>
			<xacro:ee_dyn_param side="left" ee_key="${selected_gripper_type}" arg_val="${left_dyn_param}"/>
			<xacro:ee_dyn_param side="right" ee_key="" arg_val="${right_dyn_param}"/>
		</xacro:unless>
		<param name="max_joint_speed">${max_joint_speed}</param>
		<param name="max_joint_acceleration">${max_joint_acceleration}</param>
		<param name="ctrl_mode">${arm_ctrl_mode}</param>
		<xacro:if value="${device_ip != ''}">
			<param name="device_ip">${device_ip}</param>
		</xacro:if>
	</xacro:macro>

	<!--
		KWR75 FT state interfaces within the Marvin ros2_control block.
		Only declared for kwr75_485 (COM2 RS485); kwr75_usb uses a separate
		SensorInterface that exports the same names (see ft_sensor_systems.xacro).
		Only dual-arm supported on this platform.
	-->
	<xacro:macro name="marvin_ft_sensor_interfaces" params="">
		<xacro:if value="${'$(arg left_ft)' == 'kwr75_485'}">
			<sensor name="left_ft_sensor">
				<state_interface name="force.x"/>
				<state_interface name="force.y"/>
				<state_interface name="force.z"/>
				<state_interface name="torque.x"/>
				<state_interface name="torque.y"/>
				<state_interface name="torque.z"/>
			</sensor>
		</xacro:if>
		<xacro:if value="${'$(arg right_ft)' == 'kwr75_485'}">
			<sensor name="right_ft_sensor">
				<state_interface name="force.x"/>
				<state_interface name="force.y"/>
				<state_interface name="force.z"/>
				<state_interface name="torque.x"/>
				<state_interface name="torque.y"/>
				<state_interface name="torque.z"/>
			</sensor>
		</xacro:if>
	</xacro:macro>

</robot>
