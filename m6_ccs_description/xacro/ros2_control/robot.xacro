<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="AR5">
	<xacro:arg name="ros2_control_hardware_type" default="mock_components"/>
	<xacro:arg name="ctrl_mode" default="position"/>
	<xacro:arg name="type" default="dual"/>
	<xacro:arg name="left_ee_drive_type" default=""/>
	<xacro:arg name="right_ee_drive_type" default=""/>

	<xacro:property name="is_real_hardware" value="${'$(arg ros2_control_hardware_type)' == 'real' or '$(arg ros2_control_hardware_type)' == 'real_usb'}"/>
	<xacro:property name="ee_drive_type" value="${'usb' if '$(arg ros2_control_hardware_type)' == 'real_usb' else ('marvin' if '$(arg ros2_control_hardware_type)' == 'real' else '')}"/>
	<xacro:property name="left_drive_type" value="${'$(arg left_ee_drive_type)' if '$(arg left_ee_drive_type)' != '' else ee_drive_type}"/>
	<xacro:property name="right_drive_type" value="${'$(arg right_ee_drive_type)' if '$(arg right_ee_drive_type)' != '' else ee_drive_type}"/>

	<link name="world"/>

	<joint name="world_fixed" type="fixed">
		<parent link="world"/>
		<child link="base_link"/>
		<origin/>
	</joint>

	<!-- Include robot.xacro，它会解析 type 并设置 selected_arm_config 和 selected_gripper_type -->
	<xacro:include filename="$(find m6_ccs_description)/xacro/robot.xacro"/>
	<xacro:include filename="$(find m6_ccs_description)/xacro/ros2_control/interfaces.xacro"/>
	<xacro:include filename="$(find freedom_description)/xacro/ros2_control/side_systems.xacro"/>
	<xacro:include filename="$(find inspire_description)/xacro/ros2_control/side_systems.xacro"/>

	<xacro:macro name="side_hand_interfaces" params="side hand_type">
		<xacro:if value="${hand_type == 'linkerhand_o6' or hand_type == 'linkerhand_l6'}">
			<xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/o6.xacro"/>
			<xacro:linkerhand_o6_interfaces name="${side}_hand"/>
		</xacro:if>
		<xacro:if value="${hand_type == 'linkerhand_o7'}">
			<xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/o7.xacro"/>
			<xacro:linkerhand_o7_interfaces name="${side}_hand"/>
		</xacro:if>
		<xacro:if value="${hand_type == 'freedom_v1'}">
			<xacro:include filename="$(find freedom_description)/xacro/ros2_control/freedomv1.xacro"/>
			<xacro:freedom_interfaces name="${side}_hand"/>
		</xacro:if>
		<xacro:if value="${hand_type == 'freedom_v2'}">
			<xacro:include filename="$(find freedom_description)/xacro/ros2_control/freedomv2.xacro"/>
			<xacro:freedomv2_interfaces name="${side}_hand"/>
		</xacro:if>
		<xacro:if value="${hand_type == 'inspire_e2'}">
			<xacro:include filename="$(find inspire_description)/xacro/ros2_control/RH56E2.xacro"/>
			<xacro:inspire_rh56e2_interfaces name="${side}_hand"/>
		</xacro:if>
	</xacro:macro>

	<xacro:macro name="side_usb_hand_system" params="side hand_type serial_port">
		<xacro:property name="usb_hand_system_name" value="${str('linkerhand_7' if hand_type == 'linkerhand_o7' else 'linkerhand_6')}"/>
		<ros2_control name="${usb_hand_system_name}_${side}_system" type="system">
			<hardware>
				<plugin>modbus_ros2_control/DexterousHandHardware</plugin>
				<param name="serial_port">${serial_port}</param>
				<param name="hand_type">${hand_type}</param>
				<param name="hand_side">${side}</param>
				<param name="max_speed_ratio">1.0</param>
			</hardware>
			<xacro:side_hand_interfaces side="${side}" hand_type="${hand_type}"/>
		</ros2_control>
	</xacro:macro>

	<ros2_control name="M6_CCS_System" type="system">
		<hardware>
			<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'gz'}">
				<plugin>gz_ros2_control/GazeboSimSystem</plugin>
			</xacro:if>
			<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mock_components'}">
				<plugin>mock_components/GenericSystem</plugin>
			</xacro:if>
			<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'isaac'}">
				<plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
				<param name="joint_commands_topic">/isaac/joint_command</param>
				<param name="joint_states_topic">/isaac/joint_states</param>
				<param name="sum_wrapped_joint_states">false</param>
				<param name="initialize_commands_from_state">true</param>
			</xacro:if>
			<xacro:if value="${is_real_hardware}">
				<plugin>marvin_ros2_control/MarvinHardware</plugin>
				<param name="arm_type">${selected_arm_config}</param>
				<xacro:if value="${selected_arm_config == 'dual'}">
					<xacro:property name="left_ee_type" value="${left_hand_type if left_hand_type != '' else left_gripper_type}"/>
					<xacro:property name="right_ee_type" value="${right_hand_type if right_hand_type != '' else right_gripper_type}"/>
					<xacro:if value="${(left_drive_type == 'marvin' or left_drive_type == 'tianji_can') and left_ee_type != ''}">
						<param name="left_ee_type">${left_ee_type}</param>
						<xacro:if value="${left_drive_type == 'tianji_can'}">
							<param name="left_ee_channel">1</param>
						</xacro:if>
					</xacro:if>
					<xacro:if value="${(right_drive_type == 'marvin' or right_drive_type == 'tianji_can') and right_ee_type != ''}">
						<param name="right_ee_type">${right_ee_type}</param>
						<xacro:if value="${right_drive_type == 'tianji_can'}">
							<param name="right_ee_channel">1</param>
						</xacro:if>
					</xacro:if>
				</xacro:if>
				<xacro:unless value="${selected_arm_config == 'dual'}">
					<xacro:if value="${selected_gripper_type != 'none'}">
						<param name="left_ee_type">${selected_gripper_type}</param>
					</xacro:if>
				</xacro:unless>
				<param name="max_joint_speed">50</param>
				<param name="max_joint_acceleration">30</param>
				<xacro:if value="${selected_scene == 'desktop'}">
					<param name="device_ip">192.168.10.190</param>
					<param name="ctrl_mode">JOINT_IMPEDANCE</param>
					<param name="left_dyn_param">1.2874,-10.145,30,114.65,0,0,0,0,0,0</param>
					<param name="right_dyn_param">1.2874,-30.145,-10,147.85,0,0,0,0,0,0</param>
				</xacro:if>
				<xacro:if value="${selected_scene == 'usb-90c'}">
					<param name="device_ip">192.168.10.190</param>
					<param name="ctrl_mode">CART_IMPEDANCE</param>
				</xacro:if>
			</xacro:if>
		</hardware>

		<!-- 双臂配置：按侧末端（left_type/right_type 或对称 type） -->
		<xacro:if value="${selected_arm_config == 'dual'}">
			<xacro:m6_interfaces name="left"/>
			<xacro:m6_interfaces name="right"/>

			<xacro:if value="${left_gripper_type == 'rg75'}">
				<xacro:include filename="$(find jodell_description)/xacro/ros2_control/RG75-300.xacro"/>
				<xacro:rg75_interfaces name="left"/>
			</xacro:if>
			<xacro:if value="${right_gripper_type == 'rg75'}">
				<xacro:include filename="$(find jodell_description)/xacro/ros2_control/RG75-300.xacro"/>
				<xacro:rg75_interfaces name="right"/>
			</xacro:if>

			<xacro:if value="${left_gripper_type == 'ag2f90_c' or left_gripper_type == 'ag2f90_d'}">
				<xacro:include filename="$(find changingtek_description)/xacro/ros2_control/AG2F90-C.xacro"/>
				<xacro:ag2f90c_interfaces name="left"/>
			</xacro:if>
			<xacro:if value="${right_gripper_type == 'ag2f90_c' or right_gripper_type == 'ag2f90_d'}">
				<xacro:include filename="$(find changingtek_description)/xacro/ros2_control/AG2F90-C.xacro"/>
				<xacro:ag2f90c_interfaces name="right"/>
			</xacro:if>

			<xacro:if value="${left_hand_type == 'linkerhand_o6' or left_hand_type == 'linkerhand_l6'}">
				<xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/o6.xacro"/>
				<xacro:linkerhand_o6_interfaces name="left_hand"/>
			</xacro:if>
			<xacro:if value="${right_hand_type == 'linkerhand_o6' or right_hand_type == 'linkerhand_l6'}">
				<xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/o6.xacro"/>
				<xacro:linkerhand_o6_interfaces name="right_hand"/>
			</xacro:if>
			<xacro:if value="${not is_real_hardware or left_drive_type == 'marvin' or left_drive_type == 'tianji_can'}">
				<xacro:if value="${left_hand_type != ''}">
					<xacro:side_hand_interfaces side="left" hand_type="${left_hand_type}"/>
				</xacro:if>
			</xacro:if>

			<xacro:if value="${left_hand_type == 'linkerhand_o7'}">
				<xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/o7.xacro"/>
				<xacro:linkerhand_o7_interfaces name="left_hand"/>
			</xacro:if>
			<xacro:if value="${right_hand_type == 'linkerhand_o7'}">
				<xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/o7.xacro"/>
				<xacro:linkerhand_o7_interfaces name="right_hand"/>
			</xacro:if>
			<xacro:if value="${not is_real_hardware or right_drive_type == 'marvin' or right_drive_type == 'tianji_can'}">
				<xacro:if value="${right_hand_type != ''}">
					<xacro:side_hand_interfaces side="right" hand_type="${right_hand_type}"/>
				</xacro:if>
			</xacro:if>
		</xacro:if>

		<!-- 单臂配置 -->
		<xacro:unless value="${selected_arm_config == 'dual'}">
			<xacro:if value="${selected_arm_config == 'left'}">
				<xacro:if value="${selected_scene == 'usb-90c'}">
					<xacro:m6_interfaces name="left"/>
				</xacro:if>
				<xacro:unless value="${selected_scene == 'usb-90c'}">
					<xacro:m6_interfaces name=""/>
				</xacro:unless>
				<xacro:if value="${selected_gripper_type == 'ag2f90_c' or selected_gripper_type == 'ag2f90_d'}">
					<xacro:include filename="$(find changingtek_description)/xacro/ros2_control/AG2F90-C.xacro"/>
					<xacro:ag2f90c_interfaces name=""/>
				</xacro:if>
				<xacro:if value="${selected_gripper_type == 'rg75'}">
					<xacro:include filename="$(find jodell_description)/xacro/ros2_control/RG75-300.xacro"/>
					<xacro:rg75_interfaces name=""/>
				</xacro:if>
			</xacro:if>
			<xacro:if value="${selected_arm_config == 'right'}">
				<xacro:m6_interfaces name=""/>
			</xacro:if>
		</xacro:unless>

	</ros2_control>

	<xacro:if value="${is_real_hardware and selected_arm_config == 'dual'}">
		<xacro:if value="${left_drive_type == 'usb' and (left_hand_type == 'linkerhand_o6' or left_hand_type == 'linkerhand_l6' or left_hand_type == 'linkerhand_o7')}">
			<xacro:side_usb_hand_system side="left" hand_type="${left_hand_type}" serial_port="/dev/ttyUSB0"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb' and (right_hand_type == 'linkerhand_o6' or right_hand_type == 'linkerhand_l6' or right_hand_type == 'linkerhand_o7')}">
			<xacro:side_usb_hand_system side="right" hand_type="${right_hand_type}" serial_port="/dev/ttyUSB2"/>
		</xacro:if>
		<xacro:if value="${left_drive_type == 'usb' and left_hand_type == 'inspire_e2'}">
			<xacro:inspire_rs485_side_system side="left" serial_port="/dev/ttyUSB0"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb' and right_hand_type == 'inspire_e2'}">
			<xacro:inspire_rs485_side_system side="right" serial_port="/dev/ttyUSB2"/>
		</xacro:if>
		<xacro:if value="${left_drive_type == 'usb' and left_hand_type == 'freedom_v1'}">
			<xacro:freedom_rs485_side_system side="left" serial_port="/dev/ttyUSB0"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb' and right_hand_type == 'freedom_v1'}">
			<xacro:freedom_rs485_side_system side="right" serial_port="/dev/ttyUSB2"/>
		</xacro:if>
		<xacro:if value="${left_drive_type == 'usb' and left_hand_type == 'freedom_v2'}">
			<xacro:freedom_rs485_side_system side="left" serial_port="/dev/ttyUSB0" type="freedomv2"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb' and right_hand_type == 'freedom_v2'}">
			<xacro:freedom_rs485_side_system side="right" serial_port="/dev/ttyUSB2" type="freedomv2"/>
		</xacro:if>
		<xacro:if value="${left_drive_type == 'usb_can' and left_hand_type == 'freedom_v1'}">
			<xacro:freedom_can_side_system side="left" can_interface="can0" device_id="0"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb_can' and right_hand_type == 'freedom_v1'}">
			<xacro:freedom_can_side_system side="right" can_interface="can1" device_id="1"/>
		</xacro:if>
		<xacro:if value="${left_drive_type == 'usb_can' and left_hand_type == 'inspire_e2'}">
			<xacro:inspire_canfd_side_system side="left" can_interface="can0"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb_can' and right_hand_type == 'inspire_e2'}">
			<xacro:inspire_canfd_side_system side="right" can_interface="can1"/>
		</xacro:if>
	</xacro:if>


	<xacro:arg name="gazebo" default="false"/>
	<xacro:if value="$(arg gazebo)">
		<gazebo>
			<plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
				<xacro:if value="${selected_arm_config == 'dual'}">
					<parameters>$(find m6_ccs_description)/config/ros2_control/ros2_controllers.yaml</parameters>
				</xacro:if>
				<xacro:if value="${selected_arm_config == 'left'}">
					<parameters>$(find m6_ccs_description)/config/ros2_control/left.yaml</parameters>
				</xacro:if>
				<xacro:if value="${selected_arm_config == 'right'}">
					<parameters>$(find m6_ccs_description)/config/ros2_control/right.yaml</parameters>
				</xacro:if>
			</plugin>
		</gazebo>
	</xacro:if>
</robot>
