<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="AR5">
	<xacro:arg name="ros2_control_hardware_type" default="mock_components"/>
	<xacro:arg name="ctrl_mode" default="position"/>
	<xacro:arg name="type" default="left"/>

	<link name="world"/>

	<joint name="world_fixed" type="fixed">
		<parent link="world"/>
		<child link="base_link"/>
		<origin/>
	</joint>

	<!-- Include robot.xacro，它会解析 type 并设置 selected_arm_config 和 selected_gripper_type -->
	<xacro:include filename="$(find m6_ccs_description)/xacro/robot.xacro"/>
	<xacro:include filename="$(find m6_ccs_description)/xacro/ros2_control/interfaces.xacro"/>

	<ros2_control name="M6_CCS_System" type="system">
		<hardware>
			<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'gz'}">
				<plugin>gz_ros2_control/GazeboSimSystem</plugin>
			</xacro:if>
			<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mock_components'}">
				<plugin>mock_components/GenericSystem</plugin>
			</xacro:if>
			<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'isaac'}">
				<plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
				<param name="joint_commands_topic">/isaac/joint_command</param>
				<param name="joint_states_topic">/isaac/joint_states</param>
				<param name="sum_wrapped_joint_states">false</param>
				<param name="initialize_commands_from_state">true</param>
			</xacro:if>
			<xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real'}">
				<plugin>marvin_ros2_control/MarvinHardware</plugin>
				<param name="arm_type">${selected_arm_config}</param>
				<param name="gripper_type">${selected_gripper_type}</param>
				<param name="max_joint_speed">50</param>
				<param name="max_joint_acceleration">30</param>
				<xacro:if value="${selected_scene == 'desktop'}">
					<param name="device_ip">192.168.10.190</param>
					<param name="ctrl_mode">CART_IMPEDANCE</param>
					<param name="left_dyn_param">1.2874,-10.145,30,114.65,0,0,0,0,0,0</param>
					<param name="right_dyn_param">1.2874,-30.145,-10,147.85,0,0,0,0,0,0</param>
				</xacro:if>
				<xacro:if value="${selected_scene == 'usb-90c'}">
					<param name="device_ip">192.168.10.190</param>
					<param name="ctrl_mode">CART_IMPEDANCE</param>
				</xacro:if>
			</xacro:if>
		</hardware>

		<!-- 使用 robot.xacro 中已解析的属性 -->
		<!-- 双臂配置 -->
		<xacro:if value="${selected_arm_config == 'dual'}">
			<xacro:m6_interfaces name="left"/>
			<xacro:m6_interfaces name="right"/>
			
			<xacro:if value="${selected_gripper_type == 'ag2f90_c' or selected_gripper_type == 'ag2f90_d'}">
				<xacro:include filename="$(find changingtek_description)/xacro/ros2_control/AG2F90-C.xacro"/>
				<xacro:ag2f90c_interfaces name="left"/>
				<xacro:ag2f90c_interfaces name="right"/>
			</xacro:if>

			<xacro:if value="${selected_gripper_type == 'rg75'}">
				<xacro:include filename="$(find jodell_description)/xacro/ros2_control/RG75-300.xacro"/>
				<xacro:rg75_interfaces name="left"/>
				<xacro:rg75_interfaces name="right"/>
			</xacro:if>
			
			<!-- LinkerHand dexterous hand interfaces -->
			<!-- Note: LinkerHand requires separate hardware interface (Modbus), so interfaces are included here -->
			<!-- but the actual hardware will be handled by separate DexterousHandHardware instances -->
			<xacro:if value="${selected_gripper_type == 'linkerhand_o6' or selected_gripper_type == 'linkerhand_l6'}">
				<xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/o6.xacro"/>
				<!-- Left hand -->
				<xacro:linkerhand_o6_interfaces name="left"/>
				<!-- Right hand -->
				<xacro:linkerhand_o6_interfaces name="right"/>
			</xacro:if>
			<xacro:if value="${selected_gripper_type == 'linkerhand_o7'}">
				<xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/o7.xacro"/>
				<!-- Left hand -->
				<xacro:linkerhand_o7_interfaces name="left"/>
				<!-- Right hand -->
				<xacro:linkerhand_o7_interfaces name="right"/>
			</xacro:if>
		</xacro:if>
		
		<!-- LinkerHand separate ros2_control systems (for real hardware with Modbus) -->
		<!-- These are separate systems because LinkerHand uses DexterousHandHardware, not MarvinHardware -->
		<xacro:if value="${selected_gripper_type == 'linkerhand_o6' or selected_gripper_type == 'linkerhand_l6' or selected_gripper_type == 'linkerhand_o7'}">
			<!-- Left hand system -->
			<xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/hand.xacro">
				<xacro:arg name="type" value="${selected_gripper_type == 'linkerhand_o6' ? 'o6' : (selected_gripper_type == 'linkerhand_l6' ? 'l6' : 'o7')}"/>
				<xacro:arg name="direction" value="1"/>
				<xacro:arg name="ros2_control_hardware_type" value="$(arg ros2_control_hardware_type)"/>
			</xacro:include>
			<!-- Right hand system -->
			<xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/hand.xacro">
				<xacro:arg name="type" value="${selected_gripper_type == 'linkerhand_o6' ? 'o6' : (selected_gripper_type == 'linkerhand_l6' ? 'l6' : 'o7')}"/>
				<xacro:arg name="direction" value="-1"/>
				<xacro:arg name="ros2_control_hardware_type" value="$(arg ros2_control_hardware_type)"/>
			</xacro:include>
		</xacro:if>

		<!-- 单臂配置 -->
		<xacro:unless value="${selected_arm_config == 'dual'}">
			<xacro:if value="${selected_arm_config == 'left'}">
				<xacro:if value="${selected_scene == 'usb-90c'}">
					<xacro:m6_interfaces name="left"/>
				</xacro:if>
				<xacro:unless value="${selected_scene == 'usb-90c'}">
					<xacro:m6_interfaces name=""/>
				</xacro:unless>
				<xacro:if value="${selected_gripper_type == 'ag2f90_c' or selected_gripper_type == 'ag2f90_d'}">
					<xacro:include filename="$(find changingtek_description)/xacro/ros2_control/AG2F90-C.xacro"/>
					<xacro:ag2f90c_interfaces name=""/>
				</xacro:if>
				<xacro:if value="${selected_gripper_type == 'rg75'}">
					<xacro:include filename="$(find jodell_description)/xacro/ros2_control/RG75-300.xacro"/>
					<xacro:rg75_interfaces name=""/>
				</xacro:if>
			</xacro:if>
			<xacro:if value="${selected_arm_config == 'right'}">
				<xacro:m6_interfaces name=""/>
			</xacro:if>
		</xacro:unless>

	</ros2_control>
	
	<!-- LinkerHand separate ros2_control systems (for real hardware with Modbus) -->
	<!-- These are separate systems because LinkerHand uses DexterousHandHardware, not MarvinHardware -->
	<!-- Left hand system -->
	<xacro:if value="${selected_gripper_type == 'linkerhand_o6'}">
		<xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/hand.xacro">
			<xacro:arg name="type" value="o6"/>
			<xacro:arg name="direction" value="1"/>
			<xacro:arg name="ros2_control_hardware_type" value="$(arg ros2_control_hardware_type)"/>
		</xacro:include>
	</xacro:if>
	<xacro:if value="${selected_gripper_type == 'linkerhand_l6'}">
		<xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/hand.xacro">
			<xacro:arg name="type" value="l6"/>
			<xacro:arg name="direction" value="1"/>
			<xacro:arg name="ros2_control_hardware_type" value="$(arg ros2_control_hardware_type)"/>
		</xacro:include>
	</xacro:if>
	<xacro:if value="${selected_gripper_type == 'linkerhand_o7'}">
		<xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/hand.xacro">
			<xacro:arg name="type" value="o7"/>
			<xacro:arg name="direction" value="1"/>
			<xacro:arg name="ros2_control_hardware_type" value="$(arg ros2_control_hardware_type)"/>
		</xacro:include>
	</xacro:if>
	<!-- Right hand system -->
	<xacro:if value="${selected_gripper_type == 'linkerhand_o6'}">
		<xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/hand.xacro">
			<xacro:arg name="type" value="o6"/>
			<xacro:arg name="direction" value="-1"/>
			<xacro:arg name="ros2_control_hardware_type" value="$(arg ros2_control_hardware_type)"/>
		</xacro:include>
	</xacro:if>
	<xacro:if value="${selected_gripper_type == 'linkerhand_l6'}">
		<xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/hand.xacro">
			<xacro:arg name="type" value="l6"/>
			<xacro:arg name="direction" value="-1"/>
			<xacro:arg name="ros2_control_hardware_type" value="$(arg ros2_control_hardware_type)"/>
		</xacro:include>
	</xacro:if>
	<xacro:if value="${selected_gripper_type == 'linkerhand_o7'}">
		<xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/hand.xacro">
			<xacro:arg name="type" value="o7"/>
			<xacro:arg name="direction" value="-1"/>
			<xacro:arg name="ros2_control_hardware_type" value="$(arg ros2_control_hardware_type)"/>
		</xacro:include>
	</xacro:if>


	<xacro:arg name="gazebo" default="false"/>
	<xacro:if value="$(arg gazebo)">
		<gazebo>
			<plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
				<xacro:if value="${selected_arm_config == 'left'}">
					<parameters>$(find rokae_ar5_description)/config/ros2_control/ros2_controllers.yaml</parameters>
				</xacro:if>
				<xacro:if value="${selected_arm_config == 'right'}">
					<parameters>$(find rokae_ar5_description)/config/ros2_control/right.yaml</parameters>
				</xacro:if>
			</plugin>
		</gazebo>
	</xacro:if>
</robot>