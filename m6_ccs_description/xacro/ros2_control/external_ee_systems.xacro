<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:include filename="$(find m6_ccs_description)/xacro/ros2_control/end_effector_interfaces.xacro"/>
	<xacro:include filename="$(find m6_ccs_description)/xacro/ros2_control/ft_sensor_systems.xacro"/>
	<xacro:include filename="$(find freedom_description)/xacro/ros2_control/side_systems.xacro"/>
	<xacro:include filename="$(find inspire_description)/xacro/ros2_control/side_systems.xacro"/>
	<xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/side_systems.xacro"/>
	<xacro:include filename="$(find theohand_description)/xacro/ros2_control/side_systems.xacro"/>
	<xacro:include filename="$(find jodell_description)/xacro/ros2_control/side_systems.xacro"/>
	<xacro:include filename="$(find changingtek_description)/xacro/ros2_control/side_systems.xacro"/>

	<!-- rw_rate: empty → default 200 Hz (same idea as LinkerHand USB-CAN empty → 50). -->
	<xacro:macro name="wuji_hand2_ethernet_side_system" params="
		side
		hand_side
		device_address
		serial_number
		mit_kp:=3.0
		mit_kd:=0.05
		effort_limit:=1.5
		read_feedback:=true
		require_initial_feedback:=true
		command_deadband:=0.0
		connect_timeout_ms:=5000
		enable_timeout_s:=5.0
		rw_rate:=''">
		<xacro:property name="wuji_effective_rw_rate" value="${rw_rate if rw_rate != '' else 200}"/>
		<ros2_control name="wuji_hand2_${side}_system" type="system" rw_rate="${wuji_effective_rw_rate}">
			<hardware>
				<plugin>wujihand2_ros2_control/WujiHand2Hardware</plugin>
				<param name="hand_side">${hand_side}</param>
				<param name="device_address">${device_address}</param>
				<xacro:if value="${serial_number != ''}">
					<param name="serial_number">${serial_number}</param>
				</xacro:if>
				<param name="mit_kp">${mit_kp}</param>
				<param name="mit_kd">${mit_kd}</param>
				<param name="effort_limit">${effort_limit}</param>
				<param name="read_feedback">${read_feedback}</param>
				<param name="require_initial_feedback">${require_initial_feedback}</param>
				<param name="command_deadband">${command_deadband}</param>
				<param name="connect_timeout_ms">${connect_timeout_ms}</param>
				<param name="enable_timeout_s">${enable_timeout_s}</param>
			</hardware>
			<xacro:wuji_hand2_interfaces name="${side}_hand"/>
		</ros2_control>
	</xacro:macro>

	<!-- left_ft / right_ft / usb_*_ft_port: declared in marvin_hardware.xacro; defaults read $(arg ...) here. -->
	<xacro:macro name="external_ee_systems" params="
		usb_left_port:=/dev/ttyUSB0
		usb_right_port:=/dev/ttyUSB2
		left_ee_can_interface:=can0
		right_ee_can_interface:=can1
		left_read_tactile:=false
		right_read_tactile:=false
		left_ee_rw_rate:=''
		right_ee_rw_rate:=''
		usb_baudrate:=115200
		device_address_left:=$(arg device_address_left)
		device_address_right:=$(arg device_address_right)
		serial_number_left:=$(arg serial_number_left)
		serial_number_right:=$(arg serial_number_right)
		mit_kp:=$(arg mit_kp)
		mit_kd:=$(arg mit_kd)
		effort_limit:=$(arg effort_limit)
		read_feedback:=$(arg read_feedback)
		require_initial_feedback:=$(arg require_initial_feedback)
		command_deadband:=$(arg command_deadband)
		connect_timeout_ms:=$(arg connect_timeout_ms)
		enable_timeout_s:=$(arg enable_timeout_s)
		left_ft:=$(arg left_ft)
		right_ft:=$(arg right_ft)
		usb_left_ft_port:=$(arg usb_left_ft_port)
		usb_right_ft_port:=$(arg usb_right_ft_port)">
		<xacro:if value="${left_drive_type == 'usb_can' and (left_hand_type == 'linkerhand_o6' or left_hand_type == 'linkerhand_l6' or left_hand_type == 'linkerhand_o7')}">
			<xacro:linkerhand_usb_can_side_system side="left" hand_type="${left_hand_type}" can_interface="${left_ee_can_interface}" read_tactile="${left_read_tactile}" rw_rate="${left_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb_can' and (right_hand_type == 'linkerhand_o6' or right_hand_type == 'linkerhand_l6' or right_hand_type == 'linkerhand_o7')}">
			<xacro:linkerhand_usb_can_side_system side="right" hand_type="${right_hand_type}" can_interface="${right_ee_can_interface}" read_tactile="${right_read_tactile}" rw_rate="${right_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${left_drive_type == 'usb' and (left_hand_type == 'linkerhand_o6' or left_hand_type == 'linkerhand_l6' or left_hand_type == 'linkerhand_o7')}">
			<xacro:side_usb_hand_system side="left" hand_type="${left_hand_type}" serial_port="${usb_left_port}" rw_rate="${left_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb' and (right_hand_type == 'linkerhand_o6' or right_hand_type == 'linkerhand_l6' or right_hand_type == 'linkerhand_o7')}">
			<xacro:side_usb_hand_system side="right" hand_type="${right_hand_type}" serial_port="${usb_right_port}" rw_rate="${right_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${left_drive_type == 'usb' and left_hand_type == 'theohand_std16a'}">
			<xacro:theohand_usb_side_system side="left" serial_port="${usb_left_port}" baudrate="${usb_baudrate}" rw_rate="${left_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb' and right_hand_type == 'theohand_std16a'}">
			<xacro:theohand_usb_side_system side="right" serial_port="${usb_right_port}" baudrate="${usb_baudrate}" rw_rate="${right_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${left_drive_type == 'usb' and left_hand_type == 'inspire_e2'}">
			<xacro:inspire_rs485_side_system side="left" serial_port="${usb_left_port}" rw_rate="${left_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb' and right_hand_type == 'inspire_e2'}">
			<xacro:inspire_rs485_side_system side="right" serial_port="${usb_right_port}" rw_rate="${right_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${left_drive_type == 'usb' and left_hand_type == 'inspire_f2'}">
			<xacro:inspire_rs485_side_system side="left" serial_port="${usb_left_port}" hand_type="inspire_f2" rw_rate="${left_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb' and right_hand_type == 'inspire_f2'}">
			<xacro:inspire_rs485_side_system side="right" serial_port="${usb_right_port}" hand_type="inspire_f2" rw_rate="${right_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${left_drive_type == 'usb' and left_hand_type == 'freedom_v1'}">
			<xacro:freedom_rs485_side_system side="left" serial_port="${usb_left_port}" rw_rate="${left_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb' and right_hand_type == 'freedom_v1'}">
			<xacro:freedom_rs485_side_system side="right" serial_port="${usb_right_port}" rw_rate="${right_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${left_drive_type == 'usb' and left_hand_type == 'freedom_v2'}">
			<xacro:freedom_rs485_side_system side="left" serial_port="${usb_left_port}" type="freedomv2" rw_rate="${left_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb' and right_hand_type == 'freedom_v2'}">
			<xacro:freedom_rs485_side_system side="right" serial_port="${usb_right_port}" type="freedomv2" rw_rate="${right_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${left_drive_type == 'usb' and left_hand_type == 'xhand1'}">
			<xacro:xhand1_rs485_side_system side="left" serial_port="${usb_left_port}" rw_rate="${left_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb' and right_hand_type == 'xhand1'}">
			<xacro:xhand1_rs485_side_system side="right" serial_port="${usb_right_port}" rw_rate="${right_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${left_drive_type == 'usb_can' and left_hand_type == 'freedom_v1'}">
			<xacro:freedom_can_side_system side="left" can_interface="${left_ee_can_interface}" device_id="0" rw_rate="${left_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb_can' and right_hand_type == 'freedom_v1'}">
			<xacro:freedom_can_side_system side="right" can_interface="${right_ee_can_interface}" device_id="1" rw_rate="${right_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${left_drive_type == 'usb_can' and left_hand_type == 'inspire_e2'}">
			<xacro:inspire_canfd_side_system side="left" can_interface="${left_ee_can_interface}" rw_rate="${left_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb_can' and right_hand_type == 'inspire_e2'}">
			<xacro:inspire_canfd_side_system side="right" can_interface="${right_ee_can_interface}" rw_rate="${right_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${left_drive_type == 'usb_can' and left_hand_type == 'inspire_f2'}">
			<xacro:inspire_canfd_side_system side="left" can_interface="${left_ee_can_interface}" hand_type="inspire_f2" rw_rate="${left_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb_can' and right_hand_type == 'inspire_f2'}">
			<xacro:inspire_canfd_side_system side="right" can_interface="${right_ee_can_interface}" hand_type="inspire_f2" rw_rate="${right_ee_rw_rate}"/>
		</xacro:if>

		<!-- 外接 RS485 夹爪（rg75 / ag2f90_d）；drive_type 键为 usb，串口不一定是 USB -->
		<xacro:if value="${left_drive_type == 'usb' and left_gripper_type == 'ag2f90_d'}">
			<xacro:changingtek_usb_side_system side="left" variant="90d" serial_port="${usb_left_port}" rw_rate="${left_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb' and right_gripper_type == 'ag2f90_d'}">
			<xacro:changingtek_usb_side_system side="right" variant="90d" serial_port="${usb_right_port}" rw_rate="${right_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${left_drive_type == 'usb' and left_gripper_type == 'rg75'}">
			<xacro:jodell_usb_side_system side="left" serial_port="${usb_left_port}" rw_rate="${left_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb' and right_gripper_type == 'rg75'}">
			<xacro:jodell_usb_side_system side="right" serial_port="${usb_right_port}" rw_rate="${right_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${left_drive_type == 'ethernet' and left_hand_type == 'wuji_hand2'}">
			<xacro:wuji_hand2_ethernet_side_system
				side="left"
				hand_side="left"
				device_address="${device_address_left}"
				serial_number="${serial_number_left}"
				mit_kp="${mit_kp}"
				mit_kd="${mit_kd}"
				effort_limit="${effort_limit}"
				read_feedback="${read_feedback}"
				require_initial_feedback="${require_initial_feedback}"
				command_deadband="${command_deadband}"
				connect_timeout_ms="${connect_timeout_ms}"
				enable_timeout_s="${enable_timeout_s}"
				rw_rate="${left_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'ethernet' and right_hand_type == 'wuji_hand2'}">
			<xacro:wuji_hand2_ethernet_side_system
				side="right"
				hand_side="right"
				device_address="${device_address_right}"
				serial_number="${serial_number_right}"
				mit_kp="${mit_kp}"
				mit_kd="${mit_kd}"
				effort_limit="${effort_limit}"
				read_feedback="${read_feedback}"
				require_initial_feedback="${require_initial_feedback}"
				command_deadband="${command_deadband}"
				connect_timeout_ms="${connect_timeout_ms}"
				enable_timeout_s="${enable_timeout_s}"
				rw_rate="${right_ee_rw_rate}"/>
		</xacro:if>

		<xacro:ft_sensor_systems
			left_ft="${left_ft}"
			right_ft="${right_ft}"
			usb_left_ft_port="${usb_left_ft_port}"
			usb_right_ft_port="${usb_right_ft_port}"/>
	</xacro:macro>

</robot>
