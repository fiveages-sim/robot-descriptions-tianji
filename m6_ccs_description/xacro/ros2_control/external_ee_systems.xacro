<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:include filename="$(find m6_ccs_description)/xacro/ros2_control/end_effector_interfaces.xacro"/>
	<xacro:include filename="$(find freedom_description)/xacro/ros2_control/side_systems.xacro"/>
	<xacro:include filename="$(find inspire_description)/xacro/ros2_control/side_systems.xacro"/>

	<xacro:macro name="side_usb_hand_system" params="side hand_type serial_port">
		<xacro:property name="usb_hand_system_name" value="${str('linkerhand_7' if hand_type == 'linkerhand_o7' else 'linkerhand_6')}"/>
		<ros2_control name="${usb_hand_system_name}_${side}_system" type="system">
			<hardware>
				<plugin>modbus_ros2_control/DexterousHandHardware</plugin>
				<param name="serial_port">${serial_port}</param>
				<param name="hand_type">${hand_type}</param>
				<param name="hand_side">${side}</param>
				<param name="max_speed_ratio">1.0</param>
			</hardware>
			<xacro:side_hand_interfaces side="${side}" hand_type="${hand_type}"/>
		</ros2_control>
	</xacro:macro>

	<xacro:macro name="theohand_usb_side_system" params="side serial_port baudrate:=115200 slave_id:=1">
		<ros2_control name="theohand_${side}_system" type="system">
			<hardware>
				<plugin>modbus_ros2_control/TheoHandModbusHardware</plugin>
				<param name="serial_port">${serial_port}</param>
				<param name="slave_id">${slave_id}</param>
				<param name="baudrate">${baudrate}</param>
				<param name="read_feedback">true</param>
				<param name="background_period_ms">200</param>
				<param name="feedback_quiet_after_write_ms">500</param>
			</hardware>
			<xacro:side_hand_interfaces side="${side}" hand_type="theohand_std16a"/>
		</ros2_control>
	</xacro:macro>

	<xacro:macro name="external_ee_systems" params="
		usb_left_port:=/dev/ttyUSB0
		usb_right_port:=/dev/ttyUSB2
		usb_baudrate:=115200">
		<xacro:if value="${left_drive_type == 'usb' and (left_hand_type == 'linkerhand_o6' or left_hand_type == 'linkerhand_l6' or left_hand_type == 'linkerhand_o7')}">
			<xacro:side_usb_hand_system side="left" hand_type="${left_hand_type}" serial_port="${usb_left_port}"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb' and (right_hand_type == 'linkerhand_o6' or right_hand_type == 'linkerhand_l6' or right_hand_type == 'linkerhand_o7')}">
			<xacro:side_usb_hand_system side="right" hand_type="${right_hand_type}" serial_port="${usb_right_port}"/>
		</xacro:if>
		<xacro:if value="${left_drive_type == 'usb' and left_hand_type == 'theohand_std16a'}">
			<xacro:theohand_usb_side_system side="left" serial_port="${usb_left_port}" baudrate="${usb_baudrate}"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb' and right_hand_type == 'theohand_std16a'}">
			<xacro:theohand_usb_side_system side="right" serial_port="${usb_right_port}" baudrate="${usb_baudrate}"/>
		</xacro:if>
		<xacro:if value="${left_drive_type == 'usb' and left_hand_type == 'inspire_e2'}">
			<xacro:inspire_rs485_side_system side="left" serial_port="${usb_left_port}"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb' and right_hand_type == 'inspire_e2'}">
			<xacro:inspire_rs485_side_system side="right" serial_port="${usb_right_port}"/>
		</xacro:if>
		<xacro:if value="${left_drive_type == 'usb' and left_hand_type == 'inspire_f2'}">
			<xacro:inspire_rs485_side_system side="left" serial_port="${usb_left_port}" hand_type="inspire_f2"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb' and right_hand_type == 'inspire_f2'}">
			<xacro:inspire_rs485_side_system side="right" serial_port="${usb_right_port}" hand_type="inspire_f2"/>
		</xacro:if>
		<xacro:if value="${left_drive_type == 'usb' and left_hand_type == 'freedom_v1'}">
			<xacro:freedom_rs485_side_system side="left" serial_port="${usb_left_port}"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb' and right_hand_type == 'freedom_v1'}">
			<xacro:freedom_rs485_side_system side="right" serial_port="${usb_right_port}"/>
		</xacro:if>
		<xacro:if value="${left_drive_type == 'usb' and left_hand_type == 'freedom_v2'}">
			<xacro:freedom_rs485_side_system side="left" serial_port="${usb_left_port}" type="freedomv2"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb' and right_hand_type == 'freedom_v2'}">
			<xacro:freedom_rs485_side_system side="right" serial_port="${usb_right_port}" type="freedomv2"/>
		</xacro:if>
		<xacro:if value="${left_drive_type == 'usb' and left_hand_type == 'xhand1'}">
			<xacro:xhand1_rs485_side_system side="left" serial_port="${usb_left_port}"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb' and right_hand_type == 'xhand1'}">
			<xacro:xhand1_rs485_side_system side="right" serial_port="${usb_right_port}"/>
		</xacro:if>
		<xacro:if value="${left_drive_type == 'usb_can' and left_hand_type == 'freedom_v1'}">
			<xacro:freedom_can_side_system side="left" can_interface="can0" device_id="0"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb_can' and right_hand_type == 'freedom_v1'}">
			<xacro:freedom_can_side_system side="right" can_interface="can1" device_id="1"/>
		</xacro:if>
		<xacro:if value="${left_drive_type == 'usb_can' and left_hand_type == 'inspire_e2'}">
			<xacro:inspire_canfd_side_system side="left" can_interface="can0"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb_can' and right_hand_type == 'inspire_e2'}">
			<xacro:inspire_canfd_side_system side="right" can_interface="can1"/>
		</xacro:if>
		<xacro:if value="${left_drive_type == 'usb_can' and left_hand_type == 'inspire_f2'}">
			<xacro:inspire_canfd_side_system side="left" can_interface="can0" hand_type="inspire_f2"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb_can' and right_hand_type == 'inspire_f2'}">
			<xacro:inspire_canfd_side_system side="right" can_interface="can1" hand_type="inspire_f2"/>
		</xacro:if>
	</xacro:macro>

</robot>
