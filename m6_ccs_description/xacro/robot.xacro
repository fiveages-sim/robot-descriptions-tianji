<?xml version="1.0"?>

<robot name="DobotCR5" xmlns:xacro="http://www.ros.org/wiki/xacro">
	<xacro:arg name="collider" default="convex"/>
	<xacro:arg name="type" default="left"/>

	<xacro:include filename="$(find m6_ccs_description)/xacro/arm.xacro"/>

	<xacro:if value="${'$(arg type)' == 'left'}">
		<xacro:M6_CCS/>
	</xacro:if>
	<xacro:if value="${'$(arg type)' == 'right'}">
		<xacro:M6_CCS direction="-1"/>
	</xacro:if>

	<xacro:if value="${'$(arg type)' == 'dual'}">
		<link name="base_link">
			<visual>
				<geometry>
					<mesh filename="file://$(find m6_ccs_description)/meshes/dual_base.obj"/>
				</geometry>
			</visual>
		</link>

		<!-- Left Arm -->
		<joint name="left_arm_base_joint" type="fixed">
			<parent link="base_link"/>
			<child link="left_base_link"/>
			<origin rpy="-1.5708 0 0" xyz="0.0 0.12 0.701"/>
		</joint>

		<!-- Right Arm -->
		<joint name="right_arm_base_joint" type="fixed">
			<parent link="base_link"/>
			<child link="right_base_link"/>
			<origin rpy="1.5708 0 0" xyz="0.0 -0.12 0.701"/>
		</joint>

		<xacro:M6_CCS name="left"/>
		<xacro:M6_CCS name="right" direction="-1"/>
	</xacro:if>

	<xacro:if value="${'$(arg type)' == 'usb-90c'}">
		<link name="base_link"/>
		<!-- Left Arm -->
		<joint name="base_joint" type="fixed">
			<parent link="base_link"/>
			<child link="base"/>
			<origin rpy="0 0 0"/>
		</joint>

		<link name="base">
			<visual>
				<geometry>
					<mesh filename="file://$(find m6_ccs_description)/meshes/dual_base.obj"/>
				</geometry>
			</visual>
		</link>

		<!-- Left Arm -->
		<joint name="left_arm_base_joint" type="fixed">
			<parent link="base"/>
			<child link="left_base_link"/>
			<origin rpy="-${PI/2} 0 0" xyz="0.0 0.12 0.701"/>
		</joint>

		<xacro:M6_CCS name="left"/>

		<xacro:include filename="$(find changingtek_description)/xacro/AG2F90-C.xacro"/>
		<xacro:AG2F90-C name="" use_flange="true"/>
		<joint name="gripper_fix" type="fixed">
			<parent link="left_link7"/>
			<child link="flange"/>
			<origin xyz="0 -0.0995 0" rpy=" ${PI/2} 0 0"/>
		</joint>
	</xacro:if>
</robot>
