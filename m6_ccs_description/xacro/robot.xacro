<?xml version="1.0"?>

<robot name="M6_CCS" xmlns:xacro="http://www.ros.org/wiki/xacro">
	<xacro:arg name="collider" default="convex"/>
	<xacro:arg name="type" default="left"/>
	<xacro:arg name="scene" default=""/>
	
	<!-- 质量中心偏移参数 (单位: 米) - 用于 LinkerHand 的 dyn_param 计算 -->
	<!-- 这些参数可以通过 launch 文件传递，用于调整手部的质量中心位置 -->
	<xacro:arg name="com_offset_left_x" default="0"/>
	<xacro:arg name="com_offset_left_y" default="0"/>
	<xacro:arg name="com_offset_left_z" default="0"/>
	<xacro:arg name="com_offset_right_x" default="0"/>
	<xacro:arg name="com_offset_right_y" default="0"/>
	<xacro:arg name="com_offset_right_z" default="0"/>
	
	<!-- 将参数值设置为 property，以便在 ros2_control/robot.xacro 中读取 -->
	<xacro:property name="com_offset_left_x" value="$(arg com_offset_left_x)"/>
	<xacro:property name="com_offset_left_y" value="$(arg com_offset_left_y)"/>
	<xacro:property name="com_offset_left_z" value="$(arg com_offset_left_z)"/>
	<xacro:property name="com_offset_right_x" value="$(arg com_offset_right_x)"/>
	<xacro:property name="com_offset_right_y" value="$(arg com_offset_right_y)"/>
	<xacro:property name="com_offset_right_z" value="$(arg com_offset_right_z)"/>

	<!-- 从 type 参数解析出 arm_config、gripper_type 和 scene -->
	<xacro:property name="type_arg" value="$(arg type)"/>

	<!-- 默认值 -->
	<xacro:property name="selected_arm_config" value="dual"/>
	<xacro:property name="selected_gripper_type" value="none"/>
	<xacro:property name="selected_scene" value=""/>

	<!-- 从 type 解析 arm_config 和 gripper_type -->
	<!-- 单臂配置 -->
	<xacro:if value="${type_arg == 'left'}">
		<xacro:property name="selected_arm_config" value="left"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'rg75'}">
		<xacro:property name="selected_arm_config" value="left"/>
		<xacro:property name="selected_gripper_type" value="rg75"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'right'}">
		<xacro:property name="selected_arm_config" value="right"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'usb-90c'}">
		<xacro:property name="selected_arm_config" value="left"/>
		<xacro:property name="selected_gripper_type" value="ag2f90_c"/>
		<xacro:property name="selected_scene" value="usb-90c"/>
	</xacro:if>
	<!-- 双臂配置 -->

	<!-- 适用于人形机器人的配置 -->
	<xacro:if value="${type_arg == 'dual_ag2f90'}">
		<xacro:property name="selected_gripper_type" value="ag2f90d"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'dual_ag2f90_c'}">
		<xacro:property name="selected_gripper_type" value="ag2f90_c"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'dual_ag2f90_d'}">
		<xacro:property name="selected_gripper_type" value="ag2f90_d"/>
	</xacro:if>

	<!-- 适用纯双臂演示场景的配置 -->
	<xacro:if value="${type_arg == 'dual_rg75'}">
		<xacro:property name="selected_gripper_type" value="rg75"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'dual_desktop'}">
		<xacro:property name="selected_scene" value="desktop"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'dual_desktop_90c'}">
		<xacro:property name="selected_scene" value="desktop"/>
		<xacro:property name="selected_gripper_type" value="ag2f90_c"/>
	</xacro:if>
	
	<!-- LinkerHand dexterous hand configurations -->
	<xacro:if value="${type_arg == 'dual_o6'}">
		<xacro:property name="selected_gripper_type" value="o6"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'dual_l6'}">
		<xacro:property name="selected_gripper_type" value="l6"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'dual_o7'}">
		<xacro:property name="selected_gripper_type" value="o7"/>
	</xacro:if>
	<!-- Support for linkerhand_o6, linkerhand_l6, linkerhand_o7 (from fiveages_w2_description) -->
	<xacro:if value="${type_arg == 'linkerhand_o6'}">
		<xacro:property name="selected_gripper_type" value="o6"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'linkerhand_l6'}">
		<xacro:property name="selected_gripper_type" value="l6"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'linkerhand_o7'}">
		<xacro:property name="selected_gripper_type" value="o7"/>
	</xacro:if>


	<xacro:include filename="$(find m6_ccs_description)/xacro/arm.xacro"/>

	<!-- 单左臂（不包括 usb-90c 场景） -->
	<xacro:if value="${selected_arm_config == 'left' and selected_scene != 'usb-90c'}">
		<xacro:M6_CCS collider="$(arg collider)"/>
		<xacro:if value="${selected_gripper_type == 'rg75'}">
			<xacro:include filename="$(find jodell_description)/xacro/RG75-300.xacro"/>
			<xacro:RG75-300 name="" use_flange="true"/>
			<joint name="gripper_base_joint" type="fixed">
				<parent link="tcp"/>
				<child link="flange"/>
			</joint>
		</xacro:if>
	</xacro:if>

	<!-- 单右臂 -->
	<xacro:if value="${selected_arm_config == 'right'}">
		<xacro:M6_CCS direction="-1" collider="$(arg collider)"/>
	</xacro:if>

	<!-- 双臂配置 -->
	<xacro:if value="${selected_arm_config == 'dual'}">
		<!-- Base link 和 arm_base 根据 scene 设置 -->
		<xacro:if value="${selected_scene == 'desktop'}">
			<link name="base_link"/>
			<link name="arm_base">
				<visual>
					<geometry>
						<mesh filename="file://$(find m6_ccs_description)/meshes/dual_base.obj"/>
					</geometry>
				</visual>
				<collision>
					<origin xyz="0 0 0.324331"/>
					<geometry>
						<box size="0.10045 0.100398 0.648662"/>
					</geometry>
				</collision>
			</link>

			<joint name="arm_base_joint" type="fixed">
				<parent link="base_link"/>
				<child link="arm_base"/>
			</joint>

			<!-- Left Arm -->
			<joint name="left_arm_base_joint" type="fixed">
				<parent link="arm_base"/>
				<child link="left_base_link"/>
				<origin rpy="-${PI/2} 0 0" xyz="0.0 0.12 0.701"/>
			</joint>

			<!-- Right Arm -->
			<joint name="right_arm_base_joint" type="fixed">left
				<parent link="arm_base"/>
				<child link="right_base_link"/>
				<origin rpy="${PI/2} 0 0" xyz="0.0 -0.12 0.701"/>
			</joint>

			<xacro:if value="${selected_gripper_type == 'none'}">
				<link name="right_eef"/>
				<joint name="right_eef_joint" type="fixed">
					<parent link="right_tcp"/>
					<child link="right_eef"/>
				</joint>
				<link name="left_eef"/>
				<joint name="left_eef_joint" type="fixed">
					<parent link="left_tcp"/>
					<child link="left_eef"/>
				</joint>
			</xacro:if>
		</xacro:if>

		<xacro:unless value="${selected_scene == 'desktop'}">
			<!-- 非 Desktop 场景：base_link 为空，有 arm_base -->
			<link name="base_link"/>
			<link name="arm_base">
				<collision>
					<origin xyz="0.0091 0 -0.25"/>
					<geometry>
						<box size="0.2000 0.3 0.4029"/>
					</geometry>
				</collision>
			</link>

			<joint name="arm_base_joint" type="fixed">
				<parent link="base_link"/>
				<child link="arm_base"/>
			</joint>

			<!-- Left Arm -->
			<joint name="left_arm_base_joint" type="fixed">
				<parent link="arm_base"/>
				<child link="left_base_link"/>
				<origin rpy="-${PI/2} 0 0" xyz="0.0 0.062 0"/>
			</joint>

			<!-- Right Arm -->
			<joint name="right_arm_base_joint" type="fixed">
				<parent link="arm_base"/>
				<child link="right_base_link"/>
				<origin rpy="${PI/2} 0 0" xyz="0 -0.062 0"/>
			</joint>
		</xacro:unless>

		<!-- 双臂和末端执行器（两种场景共用） -->
		<xacro:M6_CCS name="left" collider="$(arg collider)"/>
		<xacro:M6_CCS name="right" direction="-1" collider="$(arg collider)"/>

		<!-- 双臂末端执行器 -->
		<xacro:if value="${selected_gripper_type == 'ag2f90_c' or selected_gripper_type == 'ag2f90_d'}">
			<xacro:include filename="$(find changingtek_description)/xacro/AG2F90-C.xacro"/>
			<xacro:AG2F90-C name="left" use_flange="true"/>
			<joint name="left_gripper_fix" type="fixed">
				<parent link="left_tcp"/>
				<child link="left_flange"/>
				<origin xyz="0 0 0.0045"/>
			</joint>

			<xacro:AG2F90-C name="right" use_flange="true"/>
			<joint name="right_gripper_fix" type="fixed">
				<parent link="right_tcp"/>
				<child link="right_flange"/>
				<origin xyz="0 0 0.0045"/>
			</joint>
		</xacro:if>

		<xacro:if value="${selected_gripper_type == 'rg75'}">
			<xacro:include filename="$(find jodell_description)/xacro/RG75-300.xacro"/>
			<xacro:RG75-300 name="left" use_flange="true"/>
			<xacro:RG75-300 name="right" use_flange="true"/>

			<joint name="left_gripper_base_joint" type="fixed">
				<parent link="left_tcp"/>
				<child link="left_flange"/>
			</joint>

			<joint name="right_gripper_base_joint" type="fixed">
				<parent link="right_tcp"/>
				<child link="right_flange"/>
			</joint>
		</xacro:if>
	</xacro:if>

	<!-- USB-90C 配置 -->
	<xacro:if value="${selected_arm_config == 'left' and selected_scene == 'usb-90c'}">
		<link name="base_link"/>
		<!-- Left Arm -->
		<joint name="base_joint" type="fixed">
			<parent link="base_link"/>
			<child link="base"/>
		</joint>

		<link name="base">
			<visual>
				<geometry>
					<mesh filename="file://$(find m6_ccs_description)/meshes/dual_base.obj"/>
				</geometry>
			</visual>
			<collision>
				<origin xyz="0 0 0.324331"/>
				<geometry>
					<box size="0.10045 0.100398 0.648662"/>
				</geometry>
			</collision>
		</link>

		<!-- Left Arm -->
		<joint name="left_arm_base_joint" type="fixed">
			<parent link="base"/>
			<child link="left_base_link"/>
			<origin rpy="-${PI/2} 0 0" xyz="0.0 0.12 0.701"/>
		</joint>

		<xacro:M6_CCS name="left" collider="$(arg collider)"/>

		<xacro:include filename="$(find changingtek_description)/xacro/AG2F90-C.xacro"/>
		<xacro:AG2F90-C name="" use_flange="true"/>
		<joint name="gripper_fix" type="fixed">
			<parent link="left_link7"/>
			<child link="flange"/>
			<origin xyz="0 -0.0995 0" rpy=" ${PI/2} 0 0"/>
		</joint>
	</xacro:if>
</robot>
