<?xml version="1.0"?>

<robot name="M6_CCS" xmlns:xacro="http://www.ros.org/wiki/xacro">
	<xacro:arg name="collider" default="convex"/>
	<xacro:arg name="type" default="dual"/>
	<xacro:arg name="scene" default=""/>
	<xacro:arg name="left_type" default=""/>
	<xacro:arg name="right_type" default=""/>
	<xacro:arg name="eef_fixed_joints" default="false"/>
	<!-- 从 type 参数解析出 arm_config、gripper_type 和 scene -->
	<xacro:property name="type_arg" value="$(arg type)"/>
	<xacro:property name="left_type_arg" value="$(arg left_type)"/>
	<xacro:property name="right_type_arg" value="$(arg right_type)"/>
	<xacro:property name="effective_left_type" value="${left_type_arg if left_type_arg != '' else type_arg}"/>
	<xacro:property name="effective_right_type" value="${right_type_arg if right_type_arg != '' else type_arg}"/>

	<!-- 默认值 -->
	<xacro:property name="selected_arm_config" value="dual"/>
	<xacro:property name="selected_gripper_type" value="none"/>
	<xacro:property name="selected_hand_type" value="none"/>
	<xacro:property name="selected_gripper_pad" value="default"/>
	<xacro:property name="selected_scene" value=""/>

	<!-- 从 type 解析 arm_config 和 gripper_type -->
	<!-- 单臂配置 -->
	<xacro:if value="${type_arg == 'left'}">
		<xacro:property name="selected_arm_config" value="left"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'right'}">
		<xacro:property name="selected_arm_config" value="right"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'usb-90c'}">
		<xacro:property name="selected_arm_config" value="left"/>
		<xacro:property name="selected_gripper_type" value="ag2f90_c"/>
		<xacro:property name="selected_scene" value="usb-90c"/>
	</xacro:if>
	<!-- 双臂配置 -->

	<!-- 适用于人形机器人的配置 -->
	<xacro:if value="${type_arg == 'ag2f90'}">
		<xacro:property name="selected_gripper_type" value="ag2f90_d"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'ag2f90_c'}">
		<xacro:property name="selected_gripper_type" value="ag2f90_c"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'ag2f90_c_soft'}">
		<xacro:property name="selected_gripper_type" value="ag2f90_c"/>
		<xacro:property name="selected_gripper_pad" value="soft"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'ag2f90_d'}">
		<xacro:property name="selected_gripper_type" value="ag2f90_d"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'rg75'}">
		<xacro:property name="selected_gripper_type" value="rg75"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'rg75_heavy'}">
		<xacro:property name="selected_gripper_type" value="rg75"/>
		<xacro:property name="selected_gripper_pad" value="heavy_carry"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'linkerhand_o6'}">
		<xacro:property name="selected_hand_type" value="linkerhand_o6"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'linkerhand_l6'}">
		<xacro:property name="selected_hand_type" value="linkerhand_l6"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'linkerhand_o7'}">
		<xacro:property name="selected_hand_type" value="linkerhand_o7"/>
	</xacro:if>

	<!-- 适用纯双臂演示场景的配置 -->
	<xacro:if value="${type_arg == 'desktop'}">
		<xacro:property name="selected_scene" value="desktop"/>
	</xacro:if>
	<xacro:if value="${type_arg == 'desktop_90c'}">
		<xacro:property name="selected_scene" value="desktop"/>
		<xacro:property name="selected_gripper_type" value="ag2f90_c"/>
		<xacro:property name="selected_gripper_pad" value="soft"/>
	</xacro:if>


	<xacro:include filename="$(find m6_ccs_description)/xacro/arm.xacro"/>
	<xacro:include filename="$(find m6_ccs_description)/xacro/arm_mount.xacro"/>

	<!-- 单左臂（不包括 usb-90c 场景） -->
	<xacro:if value="${selected_arm_config == 'left' and selected_scene != 'usb-90c'}">
		<xacro:M6_CCS/>
		<xacro:if value="${selected_gripper_type == 'rg75'}">
			<xacro:include filename="$(find jodell_description)/xacro/RG75-300.xacro"/>
			<xacro:RG75-300 name="" use_flange="true"/>
			<joint name="gripper_base_joint" type="fixed">
				<parent link="tcp"/>
				<child link="flange"/>
			</joint>
		</xacro:if>
	</xacro:if>

	<!-- 单右臂 -->
	<xacro:if value="${selected_arm_config == 'right'}">
		<xacro:M6_CCS direction="-1"/>
	</xacro:if>

	<!-- 双臂配置 -->
	<xacro:if value="${selected_arm_config == 'dual'}">
		<!-- Base link 和 arm_base 根据 scene 设置 -->
		<xacro:if value="${selected_scene == 'desktop'}">
			<link name="base_link"/>
			<link name="arm_base">
				<visual>
					<geometry>
						<mesh filename="file://$(find m6_ccs_description)/meshes/desktop_base.glb"/>
					</geometry>
				</visual>
				<collision>
					<origin xyz="0 0 0.324331"/>
					<geometry>
						<box size="0.10045 0.100398 0.648662"/>
					</geometry>
				</collision>
			</link>

			<joint name="arm_base_joint" type="fixed">
				<parent link="base_link"/>
				<child link="arm_base"/>
			</joint>

			<xacro:DualArmMount parent="arm_base" left_xyz="0 0.12 0.701" right_xyz="0 -0.12 0.701"/>

			<xacro:if value="${selected_gripper_type == 'none'}">
				<link name="right_eef"/>
				<joint name="right_eef_joint" type="fixed">
					<parent link="right_tcp"/>
					<child link="right_eef"/>
				</joint>
				<link name="left_eef"/>
				<joint name="left_eef_joint" type="fixed">
					<parent link="left_tcp"/>
					<child link="left_eef"/>
				</joint>
			</xacro:if>
		</xacro:if>

		<xacro:unless value="${selected_scene == 'desktop'}">
			<!-- 非 Desktop 场景：base_link 为空，有 arm_base -->
			<link name="base_link"/>
			<link name="arm_base">
				<collision>
					<origin xyz="0.0091 0 -0.25"/>
					<geometry>
						<box size="0.2000 0.3 0.4029"/>
					</geometry>
				</collision>
			</link>

			<joint name="arm_base_joint" type="fixed">
				<parent link="base_link"/>
				<child link="arm_base"/>
			</joint>

			<xacro:DualArmMount parent="arm_base"/>
		</xacro:unless>

		<!-- 双臂和末端执行器（两种场景共用） -->
		<xacro:M6_CCS name="left"/>
		<xacro:M6_CCS name="right" direction="-1"/>

		<xacro:include filename="$(find m6_ccs_description)/xacro/eef_type_resolver.xacro"/>
		<xacro:set_side_eef_types side="left" type_key="${effective_left_type}"/>
		<xacro:set_side_eef_types side="right" type_key="${effective_right_type}"/>
		<xacro:include filename="$(find m6_ccs_description)/xacro/eefs.xacro"/>
		<xacro:EndEffectors
			eef_fixed_joints="$(arg eef_fixed_joints)"
			left_hand_type="${left_hand_type}"
			left_gripper_type="${left_gripper_type}"
			left_gripper_pad="${left_gripper_pad}"
			right_hand_type="${right_hand_type}"
			right_gripper_type="${right_gripper_type}"
			right_gripper_pad="${right_gripper_pad}"/>
	</xacro:if>

	<!-- USB-90C 配置 -->
	<xacro:if value="${selected_arm_config == 'left' and selected_scene == 'usb-90c'}">
		<link name="base_link"/>
		<!-- Left Arm -->
		<joint name="base_joint" type="fixed">
			<parent link="base_link"/>
			<child link="base"/>
		</joint>

		<link name="base">
			<visual>
				<geometry>
					<mesh filename="file://$(find m6_ccs_description)/meshes/desktop_base.glb"/>
				</geometry>
			</visual>
			<collision>
				<origin xyz="0 0 0.324331"/>
				<geometry>
					<box size="0.10045 0.100398 0.648662"/>
				</geometry>
			</collision>
		</link>

		<xacro:LeftArmMount parent="base"/>

		<xacro:M6_CCS name="left"/>

		<xacro:include filename="$(find changingtek_description)/xacro/AG2F90-C.xacro"/>
		<xacro:AG2F90-C name="" use_flange="true"/>
		<joint name="gripper_fix" type="fixed">
			<parent link="left_link7"/>
			<child link="flange"/>
			<origin xyz="0 -0.0995 0" rpy=" ${PI/2} 0 0"/>
		</joint>
	</xacro:if>
</robot>
