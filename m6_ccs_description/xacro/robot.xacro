<?xml version="1.0"?>

<robot name="M6_CCS" xmlns:xacro="http://www.ros.org/wiki/xacro">
	<xacro:arg name="collider" default="convex"/>
	<xacro:arg name="type" default="left"/>

	<xacro:include filename="$(find m6_ccs_description)/xacro/arm.xacro"/>

	<xacro:if value="${'$(arg type)' == 'left'}">
		<xacro:M6_CCS collider="$(arg collider)"/>
	</xacro:if>
	<xacro:if value="${'$(arg type)' == 'right'}">
		<xacro:M6_CCS direction="-1" collider="$(arg collider)"/>
	</xacro:if>

	<xacro:if value="${'$(arg type)' == 'dual' or '$(arg type)' == 'dual_ag2f90' or '$(arg type)' == 'dual_rg75'}">
		<link name="base_link"/>
		<link name="arm_base">
			<collision>
				<origin xyz="0.0091 0 -0.2"/>
				<geometry>
					<box size="0.2000 0.32 0.5029"/>
				</geometry>
			</collision>
		</link>

		<joint name="arm_base_joint" type="fixed">
			<parent link="base_link"/>
			<child link="arm_base"/>
		</joint>

		<!-- Left Arm -->
		<joint name="left_arm_base_joint" type="fixed">
			<parent link="arm_base"/>
			<child link="left_base_link"/>
			<origin rpy="-${PI/2} 0 0" xyz="0.0 0.062 0"/>
		</joint>

		<!-- Right Arm -->
		<joint name="right_arm_base_joint" type="fixed">
			<parent link="arm_base"/>
			<child link="right_base_link"/>
			<origin rpy="${PI/2} 0 0" xyz="0 -0.062 0"/>
		</joint>

		<xacro:M6_CCS name="left" collider="$(arg collider)"/>
		<xacro:M6_CCS name="right" direction="-1" collider="$(arg collider)"/>

		<xacro:if value="${'$(arg type)' == 'dual_ag2f90'}">
			<xacro:include filename="$(find changingtek_description)/xacro/AG2F90-C.xacro"/>
			<xacro:AG2F90-C name="left" use_flange="true"/>
			<joint name="left_gripper_fix" type="fixed">
				<parent link="left_tcp"/>
				<child link="left_flange"/>
				<origin xyz="0 0 0.0045"/>
			</joint>

			<xacro:AG2F90-C name="right" use_flange="true"/>
			<joint name="right_gripper_fix" type="fixed">
				<parent link="right_tcp"/>
				<child link="right_flange"/>
				<origin xyz="0 0 0.0045"/>
			</joint>
		</xacro:if>

		<xacro:if value="${'$(arg type)' == 'dual_rg75'}">
			<xacro:include filename="$(find jodell_description)/xacro/RG75-300.xacro"/>
			<xacro:RG75-300 name="left" use_flange="true"/>
			<xacro:RG75-300 name="right" use_flange="true"/>

			<joint name="left_gripper_base_joint" type="fixed">
				<parent link="left_tcp"/>
				<child link="left_flange"/>
			</joint>

			<joint name="right_gripper_base_joint" type="fixed">
				<parent link="right_tcp"/>
				<child link="right_flange"/>
			</joint>
		</xacro:if>
	</xacro:if>

	<xacro:if value="${'$(arg type)' == 'dual_desktop'}">
		<link name="base_link">
			<visual>
				<geometry>
					<mesh filename="file://$(find m6_ccs_description)/meshes/dual_base.obj"/>
				</geometry>
			</visual>
			<collision>
				<origin xyz="0 0 0.324331"/>
				<geometry>
					<box size="0.10045 0.100398 0.648662"/>
				</geometry>
			</collision>
		</link>

		<!-- Left Arm -->
		<joint name="left_arm_base_joint" type="fixed">
			<parent link="base_link"/>
			<child link="left_base_link"/>
			<origin rpy="-${PI/2} 0 0" xyz="0.0 0.12 0.701"/>
		</joint>

		<!-- Right Arm -->
		<joint name="right_arm_base_joint" type="fixed">
			<parent link="base_link"/>
			<child link="right_base_link"/>
			<origin rpy="${PI/2} 0 0" xyz="0.0 -0.12 0.701"/>
		</joint>

		<xacro:M6_CCS name="left" collider="$(arg collider)"/>
		<xacro:M6_CCS name="right" direction="-1" collider="$(arg collider)"/>
	</xacro:if>

	<xacro:if value="${'$(arg type)' == 'usb-90c'}">
		<link name="base_link"/>
		<!-- Left Arm -->
		<joint name="base_joint" type="fixed">
			<parent link="base_link"/>
			<child link="base"/>
			<origin rpy="0 0 0"/>
		</joint>

		<link name="base">
			<visual>
				<geometry>
					<mesh filename="file://$(find m6_ccs_description)/meshes/dual_base.obj"/>
				</geometry>
			</visual>
			<collision>
				<origin xyz="0 0 0.324331"/>
				<geometry>
					<box size="0.10045 0.100398 0.648662"/>
				</geometry>
			</collision>
		</link>

		<!-- Left Arm -->
		<joint name="left_arm_base_joint" type="fixed">
			<parent link="base"/>
			<child link="left_base_link"/>
			<origin rpy="-${PI/2} 0 0" xyz="0.0 0.12 0.701"/>
		</joint>

		<xacro:M6_CCS name="left" collider="$(arg collider)"/>

		<xacro:include filename="$(find changingtek_description)/xacro/AG2F90-C.xacro"/>
		<xacro:AG2F90-C name="" use_flange="true"/>
		<joint name="gripper_fix" type="fixed">
			<parent link="left_link7"/>
			<child link="flange"/>
			<origin xyz="0 -0.0995 0" rpy=" ${PI/2} 0 0"/>
		</joint>
	</xacro:if>
</robot>
