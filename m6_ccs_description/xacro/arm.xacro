<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
	<xacro:arg name="collider" default="convex"/>
	<xacro:property name="PI" value="3.1415926535897931"/>
	<xacro:property name="collider_type" value="$(arg collider)"/>
	<xacro:macro name="M6_CCS" params="name:='' direction:=1">
		<xacro:property name="prefix" value="${name + '_' if name else ''}"/>

		<!-- Base Link -->
		<link name="${prefix}base_link">
			<inertial>
				<origin xyz="0.00032267 4.798E-05 0.04066353"/>
				<mass value="1.1962"/>
				<inertia
						ixx="0.00107329" ixy="-1.68E-06" ixz="-1.05E-05"
						iyy="0.00107003" iyz="-3.43E-06" izz="0.00127315"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find m6_ccs_description)/meshes/base.glb"/>
				</geometry>
			</visual>
			<xacro:if value="${collider_type == 'convex'}">
				<collision>
					<geometry>
						<mesh filename="file://$(find m6_ccs_description)/meshes/base.glb"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collider_type == 'simple'}">
				<collision>
					<origin xyz="0 0 0.041832"/>
					<geometry>
						<cylinder length="0.083664" radius="0.051277"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>

		<!-- Link 1 -->
		<link name="${prefix}link1">
			<inertial>
				<origin xyz="0.00002347 0.00557150 -0.03075998"/>
				<mass value="1.9705"/>
				<inertia
						ixx="0.00492293" ixy="0.00000550" ixz="0.00000193"
						iyy="0.00526513" iyz="0.00033232" izz="0.00188107"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find m6_ccs_description)/meshes/link1.glb"/>
				</geometry>
			</visual>
			<xacro:if value="${collider_type == 'convex'}">
				<collision>
					<geometry>
						<mesh filename="file://$(find m6_ccs_description)/meshes/link1.glb"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collider_type == 'simple'}">
				<collision>
					<origin rpy="${PI/2} 0 0"/>
					<geometry>
						<cylinder length="0.125958" radius="0.057588"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>

		<!-- Joint 1 -->
		<joint name="${prefix}joint1" type="revolute">
			<origin xyz="0 0 0.1745" rpy="0 0 0"/>
			<parent link="${prefix}base_link"/>
			<child link="${prefix}link1"/>
			<axis xyz="0 0 1"/>
			<limit lower="-${PI*178/180}" upper="${PI*178/180}" effort="108" velocity="${PI}"/>
		</joint>

		<!-- Link 2 -->
		<link name="${prefix}link2">
			<inertial>
				<origin xyz="0.00013483 0.06170460 0.00950639"/>
				<mass value="2.24398"/>
				<inertia
						ixx="0.01194933" ixy="0.00000336" ixz="0.00000091"
						iyy="0.00361581" iyz="-0.00132804" izz="0.01098356"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find m6_ccs_description)/meshes/link2.glb"/>
				</geometry>
			</visual>
			<xacro:if value="${collider_type == 'convex'}">
				<collision>
					<geometry>
						<mesh filename="file://$(find m6_ccs_description)/meshes/link2.glb"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collider_type == 'simple'}">
				<collision>
					<origin xyz="0 0.099087 0" rpy="${PI/2} 0 0"/>
					<geometry>
						<cylinder length="0.078386" radius="0.046717"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>

		<!-- Joint 2 -->
		<joint name="${prefix}joint2" type="revolute">
			<origin rpy="${PI/2} 0 0"/>
			<parent link="${prefix}link1"/>
			<child link="${prefix}link2"/>
			<axis xyz="0 0 1"/>
			<limit lower="-${PI*118/180}" upper="${PI*118/180}" effort="108" velocity="${PI}"/>
		</joint>

		<!-- Link 3 -->
		<link name="${prefix}link3">
			<inertial>
				<origin xyz="0.00968562 0.00246599 -0.04627302"/>
				<mass value="1.9242"/>
				<inertia
						ixx="0.00718224" ixy="0.00004413" ixz="0.00089552"
						iyy="0.00762563" iyz="0.00022096" izz="0.00178597"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find m6_ccs_description)/meshes/link3.glb"/>
				</geometry>
			</visual>
			<xacro:if value="${collider_type == 'convex'}">
				<collision>
					<geometry>
						<mesh filename="file://$(find m6_ccs_description)/meshes/link3.glb"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collider_type == 'simple'}">
				<collision>
					<origin xyz="0 0 -0.098932"/>
					<geometry>
						<cylinder length="0.089056" radius="0.046717"/>
					</geometry>
				</collision>
				<collision>
					<origin xyz="0.018119 0 0" rpy="${PI/2} 0 0"/>
					<geometry>
						<cylinder length="0.117016" radius="0.049964"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>

		<!-- Joint 3 -->
		<joint name="${prefix}joint3" type="revolute">
			<origin xyz="0 0.287 0" rpy="-${PI/2} 0 0"/>
			<parent link="${prefix}link2"/>
			<child link="${prefix}link3"/>
			<axis xyz="0 0 1"/>
			<limit lower="-${PI*168/180}" upper="${PI*168/180}" effort="66" velocity="${PI}"/>
		</joint>

		<!-- Link 4 -->
		<link name="${prefix}link4">
			<inertial>
				<origin xyz="0.00850411 -0.04718223 0.00941509"/>
				<mass value="1.6085"/>
				<inertia
						ixx="0.00580480" ixy="-0.00066669" ixz="-0.00012722"
						iyy="0.00223807" iyz="0.00070523" izz="0.00533060"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find m6_ccs_description)/meshes/link4.glb"/>
				</geometry>
			</visual>
			<xacro:if value="${collider_type == 'convex'}">
				<collision>
					<geometry>
						<mesh filename="file://$(find m6_ccs_description)/meshes/link4.glb"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collider_type == 'simple'}">
				<collision>
					<origin xyz="0.017721 -0.079733 0" rpy="${PI/2} 0 0"/>
					<geometry>
						<cylinder length="0.080203" radius="0.041759"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>

		<!-- Joint 4 -->
		<joint name="${prefix}joint4" type="revolute">
			<origin xyz="0.018 0 0" rpy="-${PI/2} 0 ${PI}"/>
			<parent link="${prefix}link3"/>
			<child link="${prefix}link4"/>
			<axis xyz="0 0 1"/>
			<limit lower="-${PI*143/180}" upper="${PI*58/180}" effort="66" velocity="${PI}"/>
		</joint>

		<!-- Link 5 - Mirrored COM and partial inertia -->
		<link name="${prefix}link5">
			<inertial>
				<origin xyz="${direction*-0.00051127} ${direction*-0.00101064} -0.11271739"/>
				<mass value="2.0883"/>
				<inertia
						ixx="0.00626603" ixy="0.00004009" ixz="${direction*-0.00005338}"
						iyy="0.00564387" iyz="${direction*0.00006193}" izz="0.00243632"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find m6_ccs_description)/meshes/link5.glb" scale="1 ${direction} 1"/>
				</geometry>
			</visual>
			<xacro:if value="${collider_type == 'convex'}">
				<collision>
					<geometry>
						<mesh filename="file://$(find m6_ccs_description)/meshes/link5.glb"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collider_type == 'simple'}">
				<collision>
					<origin xyz="0 0 -0.117153"/>
					<geometry>
						<cylinder length="0.14268" radius="0.056747"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>

		<!-- Joint 5 -->
		<joint name="${prefix}joint5" type="revolute">
			<origin xyz="0.018 -0.314 0" rpy="-${PI/2} 0 ${PI}"/>
			<parent link="${prefix}link4"/>
			<child link="${prefix}link5"/>
			<axis xyz="0 0 1"/>
			<limit lower="-${PI*168/180}" upper="${PI*168/180}" effort="18" velocity="${PI}"/>
		</joint>

		<!-- Link 6 - Partially mirrored COM and inertia -->
		<link name="${prefix}link6">
			<inertial>
				<origin xyz="0.00032659 ${direction*-0.00531336} ${direction*0.00030182}"/>
				<mass value="0.72496"/>
				<inertia
						ixx="0.00046040" ixy="${direction*-0.00000189}" ixz="${direction*-0.00000083}"
						iyy="0.00051716" iyz="-0.00000346" izz="0.00042521"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find m6_ccs_description)/meshes/link6.glb"/>
				</geometry>
			</visual>
			<xacro:if value="${collider_type == 'convex'}">
				<collision>
					<geometry>
						<mesh filename="file://$(find m6_ccs_description)/meshes/link6.glb"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collider_type == 'simple'}">
				<collision>
					<origin rpy="${PI/2} 0 0"/>
					<geometry>
						<cylinder length="0.108046" radius="0.038348"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>

		<!-- Joint 6 -->
		<joint name="${prefix}joint6" type="revolute">
			<origin rpy="${PI/2} -${PI/2} 0"/>
			<parent link="${prefix}link5"/>
			<child link="${prefix}link6"/>
			<axis xyz="0 0 1"/>
			<limit lower="-${PI*58/180}" upper="${PI*58/180}" effort="18" velocity="${PI}"/>
		</joint>

		<!-- Link 7 -->
		<link name="${prefix}link7">
			<inertial>
				<origin xyz="-0.00009108 -0.03153255 0.00889371"/>
				<mass value="0.68606"/>
				<inertia
						ixx="0.00173687" ixy="-0.00000345" ixz="-0.00000116"
						iyy="0.00089035" iyz="0.00030680" izz="0.00139406"/>
			</inertial>
			<visual>
				<geometry>
					<xacro:if value="${direction == 1}">
						<mesh filename="file://$(find m6_ccs_description)/meshes/link7.glb"/>
					</xacro:if>
					<xacro:if value="${direction == -1}">
						<mesh filename="file://$(find m6_ccs_description)/meshes/link7_r.glb"/>
					</xacro:if>
				</geometry>
			</visual>
			<xacro:if value="${collider_type == 'convex'}">
				<collision>
					<geometry>
						<mesh filename="file://$(find m6_ccs_description)/meshes/link7.glb"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collider_type == 'simple'}">
				<collision>
					<origin xyz="0 -0.075732 0" rpy="${PI/2} 0 0"/>
					<geometry>
						<cylinder length="0.038392" radius="0.041707"/>
					</geometry>
				</collision>

				<xacro:if value="${selected_gripper_type == 'rg75'}">
					<collision>
						<origin xyz="0 -0.175732 0" rpy="${PI/2} 0 0"/>
						<geometry>
							<cylinder length="0.138392" radius="0.05"/>
						</geometry>
					</collision>
					<collision>
						<origin xyz="0 -0.28 0" rpy="${PI/2} 0 0"/>
						<geometry>
							<cylinder length="0.08" radius="0.021707"/>
						</geometry>
					</collision>
				</xacro:if>

				<xacro:if value="${selected_gripper_type == 'ag2f90_c' or selected_gripper_type == 'ag2f90_d'}">
					<collision>
						<origin xyz="0 -0.175732 0" rpy="${PI/2} 0 0"/>
						<geometry>
							<cylinder length="0.138392" radius="0.041707"/>
						</geometry>
					</collision>
					<collision>
						<origin xyz="0 -0.28 0" rpy="${PI/2} 0 0"/>
						<geometry>
							<cylinder length="0.08" radius="0.021707"/>
						</geometry>
					</collision>
				</xacro:if>

			</xacro:if>
		</link>

		<!-- Joint 7 -->
		<joint name="${prefix}joint7" type="revolute">
			<origin rpy="${PI/2} -${PI/2} 0"/>
			<parent link="${prefix}link6"/>
			<child link="${prefix}link7"/>
			<axis xyz="0 0 1"/>
			<limit lower="-${PI*78/180}" upper="${PI*78/180}" effort="18" velocity="${PI}"/>
		</joint>

		<link name="${prefix}tcp"/>
		<joint name="${prefix}tcp_joint" type="fixed">
			<origin rpy="${PI/2} -${PI/2} 0" xyz="0 -0.095 0"/>
			<parent link="${prefix}link7"/>
			<child link="${prefix}tcp"/>
		</joint>

	</xacro:macro>
</robot>
