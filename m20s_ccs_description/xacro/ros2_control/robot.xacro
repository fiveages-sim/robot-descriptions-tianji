<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="M20S_CCS">
	<xacro:arg name="ros2_control_hardware_type" default="mock_components"/>
	<xacro:arg name="arm_ctrl_mode" default="position"/>
	<xacro:arg name="device_ip" default=""/>
	<xacro:arg name="type" default="dual"/>
	<xacro:arg name="left_ee_drive_type" default=""/>
	<xacro:arg name="right_ee_drive_type" default=""/>

	<xacro:property name="is_real_hardware" value="${'$(arg ros2_control_hardware_type)' == 'real'}"/>
	<xacro:property name="ee_drive_type" value="${'marvin' if is_real_hardware else ''}"/>
	<xacro:property name="left_drive_type" value="${'$(arg left_ee_drive_type)' if '$(arg left_ee_drive_type)' != '' else ee_drive_type}"/>
	<xacro:property name="right_drive_type" value="${'$(arg right_ee_drive_type)' if '$(arg right_ee_drive_type)' != '' else ee_drive_type}"/>
	<xacro:arg name="left_dyn_param" default=""/>
	<xacro:arg name="right_dyn_param" default=""/>
	<xacro:arg name="max_joint_speed" default="100"/>
	<xacro:arg name="max_joint_acceleration" default="100"/>
	<xacro:arg name="usb_left_port" default="/dev/ttyUSB0"/>
	<xacro:arg name="usb_right_port" default="/dev/ttyUSB2"/>
	<xacro:arg name="left_ee_can_interface" default="can0"/>
	<xacro:arg name="right_ee_can_interface" default="can1"/>
	<xacro:arg name="left_read_tactile" default="false"/>
	<xacro:arg name="right_read_tactile" default="false"/>
	<xacro:arg name="left_ee_rw_rate" default=""/>
	<xacro:arg name="right_ee_rw_rate" default=""/>
	<!-- left_ft / right_ft / usb_*_ft_port: see marvin_hardware.xacro -->

	<link name="world"/>

	<joint name="world_fixed" type="fixed">
		<parent link="world"/>
		<child link="base_link"/>
		<origin/>
	</joint>

	<xacro:include filename="$(find m20s_ccs_description)/xacro/robot.xacro"/>
	<xacro:include filename="$(find robot_common_launch)/xacro/ros2_control/simulation_hardware.xacro"/>

	<!-- ===== 复用 m6_ccs 的硬件 / 力传感器 / 外接末端宏（不改动 m6 包） =====
	     m6 侧有两个会干扰本包的 eager include，因此顺序与条件受约束：
	       1. marvin_hardware.xacro 会 include m6 的 eefs.xacro → 同名宏覆盖本包；
	       2. external_ee_systems.xacro 会 include m6 的 end_effector_interfaces.xacro
	          → side_gripper_joint / dual_arm_ee_block 同名覆盖本包；且它无条件
	          include 各 side_systems.xacro，而这些文件在 linkerhand / jodell /
	          changingtek / theohand 中尚不存在，故只能按外接驱动条件加载
	          （加载后 external_ee_systems 宏才存在，调用点也须同样加条件）。
	     ft_sensor_systems.xacro 自带宏、无 include，可安全直接引入。
	     结论：m6 文件之后必须重新引入本包 eefs / end_effector_interfaces 夺回宏定义。 -->
	<xacro:property name="has_external_ee"
		value="${left_drive_type == 'usb' or right_drive_type == 'usb' or left_drive_type == 'usb_can' or right_drive_type == 'usb_can'}"/>

	<xacro:include filename="$(find m6_ccs_description)/xacro/ros2_control/marvin_hardware.xacro"/>
	<xacro:include filename="$(find m6_ccs_description)/xacro/ros2_control/ft_sensor_systems.xacro"/>
	<xacro:if value="${has_external_ee}">
		<xacro:include filename="$(find m6_ccs_description)/xacro/ros2_control/external_ee_systems.xacro"/>
	</xacro:if>

	<!-- 以下两个 include 必须在上面 m6 的 include 之后，职责不同：
	    - xacro/eefs.xacro：夺回被 m6 覆盖的同名宏，主要是 ee_dyn_param（负载参数表）。
	       另需注意单臂时 xacro/robot.xacro 走的是非 dual 分支、不会引入 eefs，故此处必须显式 include。
	    - ros2_control/end_effector_interfaces.xacro：双重职责
	        a) 非外接驱动（marvin / tianji_can / mock）时，m6 的 external_ee_systems 未被引入，
	            本行是 dual_arm_ee_block / single_arm_ee_block / side_gripper_joint 的唯一来源；
	        b) 外接驱动（usb / usb_can）时，m6 的 external_ee_systems 会引入 m6 版同名宏并覆盖，
	            本行负责夺回。m6 版 side_gripper_joint 没有 gripper_type 形参，被覆盖会直接报
	            "Invalid parameter gripper_type"。
	     综上：这两个 include 不可删除，也不可上移到 m6 include 之前。 -->
	<xacro:include filename="$(find m20s_ccs_description)/xacro/eefs.xacro"/>
	<xacro:include filename="$(find m20s_ccs_description)/xacro/ros2_control/end_effector_interfaces.xacro"/>

	<xacro:property name="ee_block_mode" value="${'real' if is_real_hardware else 'sim'}"/>

	<ros2_control name="M20S_CCS_System" type="system">
		<hardware>
			<xacro:unless value="${is_real_hardware}">
				<xacro:simulation_hardware_plugin hardware_type="$(arg ros2_control_hardware_type)"/>
			</xacro:unless>
			<xacro:if value="${is_real_hardware}">
				<xacro:marvin_hardware_block
					arm_type="${selected_arm_config}"
					arm_ctrl_mode="$(arg arm_ctrl_mode)"
					max_joint_speed="$(arg max_joint_speed)"
					max_joint_acceleration="$(arg max_joint_acceleration)"
					device_ip="$(arg device_ip)"
					left_dyn_param="$(arg left_dyn_param)"
					right_dyn_param="$(arg right_dyn_param)"
					selected_gripper_type="${selected_gripper_type}"/>
			</xacro:if>
		</hardware>

		<xacro:if value="${selected_arm_config == 'dual'}">
			<xacro:dual_arm_ee_block mode="${ee_block_mode}"/>
		</xacro:if>

		<xacro:unless value="${selected_arm_config == 'dual'}">
			<xacro:single_arm_ee_block mode="${ee_block_mode}" gripper_type="${selected_gripper_type}"/>
		</xacro:unless>

		<xacro:marvin_ft_sensor_interfaces/>
	</ros2_control>

	<xacro:if value="${is_real_hardware and selected_arm_config == 'dual'}">
		<!-- 外接 usb / usb_can：由 m6 external_ee_systems 分发（其内部已调用 ft_sensor_systems） -->
		<xacro:if value="${has_external_ee}">
			<xacro:external_ee_systems
				usb_left_port="$(arg usb_left_port)"
				usb_right_port="$(arg usb_right_port)"
				left_ee_can_interface="$(arg left_ee_can_interface)"
				right_ee_can_interface="$(arg right_ee_can_interface)"
				left_read_tactile="$(arg left_read_tactile)"
				right_read_tactile="$(arg right_read_tactile)"
				left_ee_rw_rate="$(arg left_ee_rw_rate)"
				right_ee_rw_rate="$(arg right_ee_rw_rate)"/>
		</xacro:if>
		<!-- 臂体总线（marvin / tianji_can）：只需力传感器系统 -->
		<xacro:unless value="${has_external_ee}">
			<xacro:ft_sensor_systems
				left_ft="$(arg left_ft)"
				right_ft="$(arg right_ft)"
				usb_left_ft_port="$(arg usb_left_ft_port)"
				usb_right_ft_port="$(arg usb_right_ft_port)"/>
		</xacro:unless>
	</xacro:if>

	<xacro:arg name="gazebo" default="false"/>
	<xacro:if value="$(arg gazebo)">
		<gazebo>
			<plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
				<xacro:if value="${selected_arm_config == 'dual'}">
					<parameters>$(find m20s_ccs_description)/config/ros2_control/ros2_controllers.yaml</parameters>
				</xacro:if>
				<xacro:if value="${selected_arm_config == 'left'}">
					<parameters>$(find m20s_ccs_description)/config/ros2_control/left.yaml</parameters>
				</xacro:if>
				<xacro:if value="${selected_arm_config == 'right'}">
					<parameters>$(find m20s_ccs_description)/config/ros2_control/right.yaml</parameters>
				</xacro:if>
			</plugin>
		</gazebo>
	</xacro:if>
</robot>
